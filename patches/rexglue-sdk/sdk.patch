+void VulkanPipelineCache::InitializeNativeDriverCache(const std::filesystem::path& path) {
+#ifdef __ANDROID__
+  // Called before persistent descriptions are queued to compilation workers.
+  if (native_driver_cache_ != VK_NULL_HANDLE) return;
+  const auto* device = command_processor_.GetVulkanDevice();
+  const auto& f = device->functions();
+  std::vector<uint8_t> data;
+  std::error_code ec;
+  const uint64_t size = std::filesystem::file_size(path, ec);
+  if (!ec && size >= sizeof(VkPipelineCacheHeaderVersionOne) && size <= (UINT64_C(64) << 20)) {
+    data.resize(size);
+    std::ifstream input(path, std::ios::binary);
+    input.read(reinterpret_cast<char*>(data.data()), data.size());
+    VkPipelineCacheHeaderVersionOne header{};
+    std::memcpy(&header, data.data(), sizeof(header));
+    VkPhysicalDeviceProperties properties;
+    device->vulkan_instance()->functions().vkGetPhysicalDeviceProperties(device->physical_device(), &properties);
+    if (!input || header.headerVersion != VK_PIPELINE_CACHE_HEADER_VERSION_ONE ||
+        header.headerSize < sizeof(header) || header.headerSize > data.size() ||
+        header.vendorID != properties.vendorID || header.deviceID != properties.deviceID ||
+        std::memcmp(header.pipelineCacheUUID, properties.pipelineCacheUUID, VK_UUID_SIZE)) {
+      data.clear();
+      REXGPU_WARN("Ignoring incompatible or truncated native pipeline cache");
+    }
+  }
+  VkPipelineCacheCreateInfo info{VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO};
+  info.initialDataSize = data.size(); info.pInitialData = data.empty() ? nullptr : data.data();
+  VkResult result = f.vkCreatePipelineCache(device->device(), &info, nullptr, &native_driver_cache_);
+  if (result != VK_SUCCESS && !data.empty()) {
+    data.clear();
+    info.initialDataSize = 0; info.pInitialData = nullptr;
+    result = f.vkCreatePipelineCache(device->device(), &info, nullptr, &native_driver_cache_);
+  }
+  if (result == VK_SUCCESS) {
+    native_driver_cache_path_ = path;
+    REXGPU_INFO("[PIPELINE_CACHE] native initialized bytes={} path={}", data.size(), path.string());
+  } else {
+    native_driver_cache_ = VK_NULL_HANDLE;
+    REXGPU_WARN("[PIPELINE_CACHE] native unavailable result={}", int(result));
+  }
+#endif
+}
+
+void VulkanPipelineCache::SaveNativeDriverCache(bool force) {
+  // One writer at most. Never join a live writer on the command processor
+  // thread during gameplay. Shutdown joins before destroying its VkDevice/cache.
+  if (native_driver_cache_save_.valid()) {
+    if (!force && native_driver_cache_save_.wait_for(std::chrono::seconds(0)) !=
+                      std::future_status::ready) return;
+    native_driver_cache_save_.get();
+  }
+  if (native_driver_cache_ == VK_NULL_HANDLE || native_driver_cache_path_.empty()) return;
+  const uint64_t now = std::chrono::duration_cast<std::chrono::milliseconds>(
+      std::chrono::steady_clock::now().time_since_epoch()).count();
+  if (!force && now - native_driver_cache_saved_ms_ < 30000) return;
+  if (!native_driver_cache_dirty_.exchange(false, std::memory_order_relaxed)) return;
+  native_driver_cache_saved_ms_ = now;
+  if (force) {
+    WriteNativeDriverCache();
+  } else {
+    try {
+      native_driver_cache_save_ = std::async(std::launch::async, [this] {
+        try { WriteNativeDriverCache(); }
+        catch (const std::exception& error) {
+          native_driver_cache_dirty_.store(true);
+          REXGPU_WARN("[PIPELINE_CACHE] background save failed: {}", error.what());
+        }
+      });
+    } catch (const std::exception& error) {
+      native_driver_cache_dirty_.store(true);
+      REXGPU_WARN("[PIPELINE_CACHE] unable to start writer: {}", error.what());
+    }
+  }
+}
+
+void VulkanPipelineCache::WriteNativeDriverCache() {
+  // The cache is created without EXTERNALLY_SYNCHRONIZED. Vulkan synchronizes
+  // pipeline creation internally. A changing size may return VK_INCOMPLETE;
+  // retain dirty state and retry later, never publish a partial snapshot.
+  const auto started = std::chrono::steady_clock::now();
+  const auto* device = command_processor_.GetVulkanDevice();
+  const auto& f = device->functions();
+  size_t size = 0;
+  VkResult result = f.vkGetPipelineCacheData(device->device(), native_driver_cache_, &size, nullptr);
+  if (result != VK_SUCCESS || size < sizeof(VkPipelineCacheHeaderVersionOne) || size > (size_t(64) << 20)) {
+    native_driver_cache_dirty_.store(true); return;
+  }
+  std::vector<uint8_t> data(size);
+  result = f.vkGetPipelineCacheData(device->device(), native_driver_cache_, &size, data.data());
+  if (result != VK_SUCCESS) { native_driver_cache_dirty_.store(true); return; }
+  auto temporary = native_driver_cache_path_; temporary += ".tmp";
+  std::ofstream output(temporary, std::ios::binary | std::ios::trunc);
+  output.write(reinterpret_cast<const char*>(data.data()), size);
+  output.flush();
+  output.close();
+  const bool written = bool(output);
+  std::error_code ec;
+  if (written) std::filesystem::rename(temporary, native_driver_cache_path_, ec);
+  if (!written || ec) {
+    native_driver_cache_dirty_.store(true);
+    REXGPU_WARN("[PIPELINE_CACHE] native save failed: {}", ec.message());
+  } else {
+    REXGPU_INFO("[PIPELINE_CACHE] native saved bytes={} serialization_io_ms={:.3f}", size,
+        std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - started).count());
+  }
+}
