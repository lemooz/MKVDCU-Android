+                           VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                           VK_ACCESS_MEMORY_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT);
+  }
+  SubmitBarriers(true);
+  for (const auto& range : ranges) {
+    const VkBufferCopy copy = {range.source_offset, range.offset, range.copied};
+    deferred_command_buffer_.CmdVkCopyBuffer(range.source, staging, 1, &copy);
+  }
+  PushBufferMemoryBarrier(staging, 0, total, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                         VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+                         VK_ACCESS_HOST_READ_BIT);
