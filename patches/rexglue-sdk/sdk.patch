+bool DeferredCommandBuffer::ExpandOpenRenderArea(VkRect2D& area) {
+  if (open_render_area_command_ == SIZE_MAX ||
+      open_render_area_command_ + kCommandHeaderSizeElements >= command_stream_.size())
+    return false;
+  const auto& header = *reinterpret_cast<const CommandHeader*>(
+      command_stream_.data() + open_render_area_command_);
+  auto* data = reinterpret_cast<uint8_t*>(
+      command_stream_.data() + open_render_area_command_ + kCommandHeaderSizeElements);
+  VkRect2D* recorded = nullptr;
+  if (header.command == Command::kVkBeginRenderPass) {
+    auto& args = *reinterpret_cast<ArgsVkBeginRenderPass*>(data);
+    if (args.clear_value_count) return false;
+    recorded = &args.render_area;
+  } else if (header.command == Command::kVkBeginRendering) {
+    auto& args = *reinterpret_cast<ArgsVkBeginRendering*>(data);
+    if (args.flags) return false;
+    auto* attachments = reinterpret_cast<const VkRenderingAttachmentInfo*>(
+        data + rex::align(sizeof(args), alignof(VkRenderingAttachmentInfo)));
+    const uint32_t count = args.color_attachment_count + uint32_t(args.has_depth_attachment) +
+                           uint32_t(args.has_stencil_attachment);
+    for (uint32_t i = 0; i < count; ++i)
+      if (attachments[i].imageView != VK_NULL_HANDLE &&
+          attachments[i].loadOp != VK_ATTACHMENT_LOAD_OP_LOAD) return false;
+    recorded = &args.render_area;
+  } else {
+    return false;
+  }
+  if (area.offset.x < 0 || area.offset.y < 0 || recorded->offset.x < 0 || recorded->offset.y < 0)
+    return false;
+  const int64_t left = std::min(area.offset.x, recorded->offset.x);
+  const int64_t top = std::min(area.offset.y, recorded->offset.y);
+  const int64_t right = std::max(int64_t(area.offset.x) + area.extent.width,
+                               int64_t(recorded->offset.x) + recorded->extent.width);
+  const int64_t bottom = std::max(int64_t(area.offset.y) + area.extent.height,
+                                int64_t(recorded->offset.y) + recorded->extent.height);
+  if (right - left > UINT32_MAX || bottom - top > UINT32_MAX) return false;
+  area = {{int32_t(left), int32_t(top)}, {uint32_t(right - left), uint32_t(bottom - top)}};
+  *recorded = area;
+  return true;
+}
