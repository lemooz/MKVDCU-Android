+bool VulkanCommandProcessor::ProbeDrawBuffers(uint64_t draw_id) {
+#ifdef __ANDROID__
+  auto* vs = active_vertex_shader();
+  auto* ps = active_pixel_shader();
+  if (!vs || vs->memexport_eM_written() || (ps && ps->memexport_eM_written())) {
+    REXLOG_WARN("[FRAMEPROBE][DRAW_BUFFER] draw={} unavailable: memexport could alias inputs", draw_id);
+    return true;
+  }
+  struct Range {
+    const char* kind;
+    uint32_t slot, address, physical, requested, copied, endian, format;
+    VkDeviceSize offset;
+    VkBuffer source;
+    VkDeviceSize source_offset;
+  };
+  std::vector<Range> ranges;
+  VkDeviceSize total = 0;
+  auto add = [&](const char* kind, uint32_t slot, uint32_t address,
+                 uint64_t length, uint32_t endian, uint32_t format) {
+    const uint32_t physical = address & (SharedMemory::kBufferSize - 1);
+    const uint32_t aligned = physical & ~UINT32_C(3);
+    const uint64_t copied = (uint64_t(physical - aligned) + length + 3) & ~UINT64_C(3);
+    if (!length || length > (UINT64_C(4) << 20) ||
+        uint64_t(aligned) + copied > SharedMemory::kBufferSize ||
+        total + copied > (UINT64_C(16) << 20)) {
+      REXLOG_WARN("[FRAMEPROBE][DRAW_BUFFER] draw={} kind={} slot={} address=0x{:08X} "
+                  "unavailable bounded_range bytes={}", draw_id, kind, slot, address, length);
+      return;
+    }
+    ranges.push_back({kind, slot, address, physical, uint32_t(length), uint32_t(copied),
+                      endian, format, total, shared_memory_->buffer(), aligned});
+    total += copied;
+  };
+  const auto& map = vs->constant_register_map();
+  for (uint32_t word = 0; word < rex::countof(map.vertex_fetch_bitmap); ++word) {
+    for (uint32_t bit = 0; bit < 32; ++bit) {
+      if (!(map.vertex_fetch_bitmap[word] & (uint32_t(1) << bit))) continue;
+      const uint32_t slot = word * 32 + bit;
+      const auto fetch = register_file_->GetVertexFetch(slot);
+      if (fetch.type != xenos::FetchConstantType::kVertex) continue;
+      add("vertex", slot, fetch.address << 2, uint64_t(fetch.size) << 2,
+          uint32_t(fetch.endian), 0);
+    }
+  }
+  if (probe_index_buffer_ && probe_index_count_) {
+    // Copy the actual bound index buffer, including host-converted indices.
+    // The raw guest DMA buffer may never have been resident on the GPU.
+    const uint64_t bytes = uint64_t(probe_index_count_) *
+        (probe_index_format_ == xenos::IndexFormat::kInt16 ? 2 : 4);
+    const VkDeviceSize aligned_offset = probe_index_offset_ & ~VkDeviceSize(3);
+    const uint64_t copied = (probe_index_offset_ - aligned_offset + bytes + 3) & ~UINT64_C(3);
+    if (bytes <= (UINT64_C(4) << 20) && total + copied <= (UINT64_C(16) << 20) &&
+        REXCVAR_QUERY(bool, vulkan_frame_probe_prepare)) {
+      ranges.push_back({"index_bound", 0, 0, uint32_t(probe_index_offset_ - aligned_offset),
+                        uint32_t(bytes), uint32_t(copied), uint32_t(xenos::Endian::kNone),
+                        uint32_t(probe_index_format_), total, probe_index_buffer_, aligned_offset});
+      total += copied;
+    } else {
+      REXLOG_WARN("[FRAMEPROBE][DRAW_BUFFER] draw={} unavailable bound-index usage or size", draw_id);
+    }
+  } else {
+    REXLOG_INFO("[FRAMEPROBE][DRAW_BUFFER] draw={} index=unavailable: automatic or immediate source", draw_id);
+  }
+  if (ranges.empty() || !BeginSubmission(true)) return true;
+  const auto* device = GetVulkanDevice();
+  const auto& dfn = device->functions();
+  const VkDevice vk_device = device->device();
+  VkBuffer staging = VK_NULL_HANDLE;
+  VkDeviceMemory memory = VK_NULL_HANDLE;
+  if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+          device, total, VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+          ui::vulkan::util::MemoryPurpose::kReadback, staging, memory)) {
+    REXLOG_ERROR("[FRAMEPROBE][DRAW_BUFFER] draw={} staging allocation failed", draw_id);
+    return false;
