+uint32_t VulkanCommandProcessor::BeginGpuStageTiming(rex::diagnostics::PerformanceStage stage) {
+#ifdef __ANDROID__
+  // No per-draw query traffic in normal mode. Sample one frame in 64, and never
+  // include intentionally stalled readback frames in these GPU measurements.
+  const int32_t interval = std::max<int32_t>(0, REXCVAR_GET(vulkan_gpu_stage_timing_interval));
+  if (!interval || !rex::diagnostics::PerformanceEnabled() ||
+      FrameCaptureArmed() || frame_current_ % uint32_t(interval) || !submission_open_ ||
+      !submission_timing_bits_ || submission_timing_period_ <= 0) return UINT32_MAX;
+  if (stage_timing_frame_ != frame_current_) {
+    stage_timing_frame_ = frame_current_;
+    stage_timing_draw_samples_ = 0;
+    stage_timing_dump_samples_ = 0;
+    stage_timing_resolve_samples_ = 0;
+    stage_timing_upload_samples_ = 0;
+  }
+  uint32_t* stage_sample_count = nullptr;
+  uint32_t stage_sample_limit = 0;
+  switch (stage) {
+    case rex::diagnostics::PerformanceStage::GpuDraw:
+      stage_sample_count = &stage_timing_draw_samples_; stage_sample_limit = 192; break;
+    case rex::diagnostics::PerformanceStage::GpuRtDump:
+      stage_sample_count = &stage_timing_dump_samples_; stage_sample_limit = 24; break;
+    case rex::diagnostics::PerformanceStage::GpuResolve:
+      stage_sample_count = &stage_timing_resolve_samples_; stage_sample_limit = 16; break;
+    case rex::diagnostics::PerformanceStage::GpuTextureUpload:
+      stage_sample_count = &stage_timing_upload_samples_; stage_sample_limit = 24; break;
+    default:
+      return UINT32_MAX;
+  }
+  if (*stage_sample_count >= stage_sample_limit) return UINT32_MAX;
+  const auto* device = GetVulkanDevice();
+  if (!stage_timing_attempted_) {
+    stage_timing_attempted_ = true;
+    VkQueryPoolCreateInfo info{VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO};
+    info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+    info.queryCount = uint32_t(stage_timings_.size()) * 2;
+    if (device->functions().vkCreateQueryPool(device->device(), &info, nullptr,
+                                              &stage_timing_pool_) != VK_SUCCESS)
+      stage_timing_pool_ = VK_NULL_HANDLE;
+  }
+  if (stage_timing_pool_ == VK_NULL_HANDLE) return UINT32_MAX;
+  for (uint32_t i = 0; i < stage_timings_.size(); ++i) {
+    if (stage_timings_[i].submission) continue;
+    stage_timings_[i] = {GetCurrentSubmission(), stage, false};
+    ++*stage_sample_count;
+    // Reset is recorded separately, before deferred render passes execute.
+    deferred_command_buffer_.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                                                stage_timing_pool_, i * 2);
+    return i;
+  }
+#endif
+  return UINT32_MAX;
+}
+
+void VulkanCommandProcessor::PrepareForWait() {
+  // Batching must not keep work CPU-side while the title or ring processor
+  // waits for GPU progress. Keep normal per-primary submission unchanged.
+  if (!REXCVAR_GET(vulkan_submit_on_primary_buffer_end) && submission_open_ &&
+      !scratch_buffer_used_ && !active_occlusion_query_.valid) {
+    // At an idle/poll boundary, waiting for pipeline creation in EndSubmission
+    // is necessary: skipping this flush could leave the title waiting forever
+    // with its GPU work still in the CPU stream and no next primary buffer.
+    EndSubmission(false);
+  }
+}
+
+void VulkanCommandProcessor::EndGpuStageTiming(uint32_t token) {
+  if (token == UINT32_MAX) return;
+  auto& timing = stage_timings_[token];
+  assert_true(timing.submission == GetCurrentSubmission());
+  timing.ended = true;
+  deferred_command_buffer_.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+                                              stage_timing_pool_, token * 2 + 1);
+}
