+#ifdef __ANDROID__
+void VulkanTextureCache::ProbeFirstGuestTexture(uint32_t fetch_constant_index) {
+  if (!REXCVAR_QUERY(bool, vulkan_frame_probe)) return;
+  if (FrameCaptureManual() && !FrameCaptureArmed()) return;
+  // Read back a handful of distinct textures so the probe reaches the assets
+  // sampled by the early UI draws, rather than just the first boot/logo image.
+  static std::mutex probe_mutex;
+  static std::array<uint32_t, 32> probed_addresses{};
+  static size_t probed_count = 0;
+  static uint64_t epoch = 0;
+  if (epoch != FrameCaptureEpoch()) {
+    std::lock_guard<std::mutex> lock(probe_mutex);
+    epoch = FrameCaptureEpoch();
+    probed_count = 0;
+  }
+  const TextureBinding* binding = GetValidTextureBinding(fetch_constant_index);
+  if (!binding || !binding->texture) {
+    return;
+  }
+
+  auto* texture = static_cast<VulkanTexture*>(binding->texture);
+  const TextureKey& key = texture->key();
+  const uint32_t address = uint32_t(key.base_page) << 12;
+  const xenos::xe_gpu_texture_fetch_t fetch =
+      command_processor_.register_file_->GetTextureFetch(fetch_constant_index);
+  {
+    std::lock_guard<std::mutex> lock(probe_mutex);
+    if (std::find(probed_addresses.begin(), probed_addresses.begin() + probed_count, address) !=
+        probed_addresses.begin() + probed_count) {
+      return;
+    }
+    if (probed_count == (FrameCaptureManual() ? probed_addresses.size() : size_t(8))) {
+      return;
+    }
+    probed_addresses[probed_count++] = address;
+  }
+  const uint32_t width = key.GetWidth();
+  const uint32_t height = key.GetHeight();
+  const HostFormatPair& host_pair = GetHostFormatPair(key);
+  const HostFormat& host_format = host_pair.format_unsigned;
+  uint32_t bytes_per_block = 0;
+  uint32_t block_width = 1, block_height = 1;
+  if (host_format.load_shader != kLoadShaderIndexUnknown) {
+    bytes_per_block = GetLoadShaderInfo(host_format.load_shader).bytes_per_host_block;
+  }
+  if (host_format.block_compressed) {
+    const FormatInfo* guest_format_info = FormatInfo::Get(uint32_t(key.format));
+    block_width = guest_format_info->block_width;
+    block_height = guest_format_info->block_height;
+  }
+
+  // This is a CPU RAM snapshot, not a readback of GPU shared memory. GPU
+  // resolves may never update this copy. Never classify a resolve from it.
+  const uint8_t* guest_bytes = command_processor_.memory_->TranslatePhysical(address);
+  uint64_t guest_non_zero = 0;
+  uint64_t guest_checksum = 1469598103934665603ull;
+  std::string guest_sample;
+  if (guest_bytes) {
+    const uint32_t guest_size = std::min(texture->GetGuestBaseSize(), UINT32_C(1) << 20);
+    for (uint32_t i = 0; i < guest_size; ++i) {
+      guest_non_zero += guest_bytes[i] != 0;
+      guest_checksum = (guest_checksum ^ guest_bytes[i]) * 1099511628211ull;
+      if (i < 16) {
+        if (i) guest_sample += ' ';
+        guest_sample += fmt::format("{:02X}", guest_bytes[i]);
+      }
+    }
+  }
+  REXLOG_INFO("[FRAMEPROBE][GAME_TEXTURE] fetch={} address=0x{:08X} format={} dim={} "
+              "width={} height={} pitch={} tiled={} endian={} swizzle=0x{:03X} "
+              "host_swizzle=0x{:03X} host_format={} load_shader={} "
+              "cpu_snapshot_unsynchronized_nonZeroBytes={} "
+              "cpu_snapshot_checksum=0x{:016X} cpu_snapshot_sample={}",
+              fetch_constant_index, address, uint32_t(key.format),
+              uint32_t(key.dimension), width, height, uint32_t(key.pitch) << 5,
+              uint32_t(key.tiled), uint32_t(key.endianness), fetch.swizzle,
+              binding->host_swizzle, uint32_t(host_format.format),
+              uint32_t(host_format.load_shader), guest_non_zero, guest_checksum, guest_sample);
+
+  if (!guest_bytes || !bytes_per_block || !texture->transfer_src_supported() ||
+      width < block_width || height < block_height) {
+    REXLOG_WARN("[FRAMEPROBE][GAME_TEXTURE] readback unavailable guest={} bytes_per_block={} "
+                "transfer_src={} block={}x{}",
+                guest_bytes != nullptr, bytes_per_block, texture->transfer_src_supported(),
+                block_width, block_height);
+    return;
+  }
+
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  const uint64_t block_count_x = (uint64_t(width) + block_width - 1) / block_width;
+  const uint64_t block_count_y = (uint64_t(height) + block_height - 1) / block_height;
+  const uint64_t readback_size_64 = block_count_x * block_count_y * bytes_per_block;
+  // Early UI/render-target surfaces may be 1040x624 RGBA (about 2.5 MiB).
+  // Keep the probe bounded, but include those because they are the actual
+  // TextureFetch(0) inputs implicated by the dark frame.
+  if (!readback_size_64 || readback_size_64 > (UINT32_C(4) << 20)) {
+    REXLOG_WARN("[FRAMEPROBE][GAME_TEXTURE_IMAGE] refusing readback size={}", readback_size_64);
+    return;
+  }
+  const uint32_t readback_size = uint32_t(readback_size_64);
+  VkBuffer readback_buffer = VK_NULL_HANDLE;
+  VkDeviceMemory readback_memory = VK_NULL_HANDLE;
+  if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+          vulkan_device, readback_size, VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+          ui::vulkan::util::MemoryPurpose::kReadback, readback_buffer, readback_memory)) {
+    REXLOG_ERROR("[FRAMEPROBE][GAME_TEXTURE] staging allocation failed");
+    return;
+  }
+  void* mapped = nullptr;
+  if (dfn.vkMapMemory(device, readback_memory, 0, VK_WHOLE_SIZE, 0, &mapped) != VK_SUCCESS) {
+    dfn.vkDestroyBuffer(device, readback_buffer, nullptr);
+    dfn.vkFreeMemory(device, readback_memory, nullptr);
