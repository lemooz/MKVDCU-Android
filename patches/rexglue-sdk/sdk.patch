diff --git a/include/rex/diagnostics/health.h b/include/rex/diagnostics/health.h
new file mode 100644
index 0000000..ea8f1ac
--- /dev/null
+++ b/include/rex/diagnostics/health.h
@@ -0,0 +1,54 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+#if defined(_WIN32)
+#if defined(REX_HEALTH_IMPLEMENTATION)
+#define REX_HEALTH_API __declspec(dllexport)
+#else
+#define REX_HEALTH_API __declspec(dllimport)
+#endif
+#else
+#define REX_HEALTH_API __attribute__((visibility("default")))
+#endif
+
+namespace rex::diagnostics {
+// One implementation in rexruntime: UI, GPU plugin and game must share counters.
+enum class HealthEvent : uint32_t {
+  SwapEnter, SwapReturn, GpuSwap, FramePublished, PaintQueued, PaintConsumed,
+  PaintEnter, PaintReturn, Submitted, PresentReturn, FenceComplete,
+  InputPoll, StartDown, StartUp, AudioCallback, AudioReturn, AudioSubmit,
+  AudioConsume, XmaWork, WaitEnter, WaitReturn, Signal, Count
+};
+
+REX_HEALTH_API void EnableHealth(bool enabled);
+REX_HEALTH_API void HealthRecord(HealthEvent event, uint64_t detail = 0);
+REX_HEALTH_API std::string HealthSummary();
+REX_HEALTH_API std::string HealthThreads();
+
+// Labels must have static lifetime. Only the executing thread publishes its
+// stage and guest LR; readers never dereference another thread's PPCContext.
+class REX_HEALTH_API HealthScope {
+ public:
+  explicit HealthScope(const char* label, uint64_t detail = 0);
+  ~HealthScope();
+  HealthScope(const HealthScope&) = delete;
+  HealthScope& operator=(const HealthScope&) = delete;
+ private:
+  int slot_ = -1;
+  const char* previous_label_ = nullptr;
+  uint64_t previous_detail_ = 0, previous_started_ = 0;
+  uint32_t previous_lr_ = 0;
+};
+
+class HealthCall {
+ public:
+  HealthCall(const char* label, HealthEvent enter, HealthEvent leave, uint64_t detail = 0)
+      : scope_(label, detail), leave_(leave) { HealthRecord(enter, detail); }
+  ~HealthCall() { HealthRecord(leave_); }
+ private:
+  HealthScope scope_;
+  HealthEvent leave_;
+};
+}  // namespace rex::diagnostics
diff --git a/include/rex/diagnostics/performance.h b/include/rex/diagnostics/performance.h
new file mode 100644
