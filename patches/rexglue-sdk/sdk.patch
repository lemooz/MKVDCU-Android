diff --git a/src/system/health.cpp b/src/system/health.cpp
new file mode 100644
index 0000000..2cd2fd7
--- /dev/null
+++ b/src/system/health.cpp
@@ -0,0 +1,138 @@
+#define REX_HEALTH_IMPLEMENTATION
+#include <rex/diagnostics/health.h>
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <sstream>
+#include <rex/system/thread_state.h>
+#if defined(__ANDROID__) || defined(__linux__)
+#include <sys/syscall.h>
+#include <unistd.h>
+#elif defined(_WIN32)
+#include <Windows.h>
+#else
+#include <functional>
+#include <thread>
+#endif
+
+namespace rex::diagnostics {
+namespace {
+constexpr size_t kThreads = 128;
+struct Metric {
+  std::atomic<uint64_t> count{0}, last{0}, detail{0};
+};
+struct ThreadStage {
+  std::atomic<uint32_t> tid{0}, guest{0}, lr{0};
+  std::atomic<const char*> label{nullptr};
+  std::atomic<uint64_t> started{0}, detail{0};
+};
+std::atomic<bool> enabled{false};
+std::array<Metric, size_t(HealthEvent::Count)> metrics;
+std::array<ThreadStage, kThreads> threads;
+constexpr const char* names[] = {
+  "swap_in", "swap_out", "gpu_swap", "published", "queued", "consumed",
+  "paint_in", "paint_out", "submit", "present", "fence", "input",
+  "start_down", "start_up", "audio_in", "audio_out", "audio_submit",
+  "audio_play", "xma", "wait_in", "wait_out", "signal"
+};
+static_assert(std::size(names) == size_t(HealthEvent::Count));
+uint64_t Now() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+      std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+uint32_t Tid() {
+#if defined(__ANDROID__) || defined(__linux__)
+  return uint32_t(syscall(SYS_gettid));
+#elif defined(_WIN32)
+  return GetCurrentThreadId();
+#else
+  return uint32_t(std::hash<std::thread::id>{}(std::this_thread::get_id())) | 1;
+#endif
+}
+struct Registration {
+  int index = -1;
+  Registration() {
+    const uint32_t tid = Tid();
+    for (size_t i = 0; i < threads.size(); ++i) {
+      uint32_t empty = 0;
+      if (threads[i].tid.compare_exchange_strong(empty, tid)) {
+        index = int(i);
+        break;
+      }
+    }
+  }
+  ~Registration() {
+    if (index >= 0) {
+      threads[index].label.store(nullptr, std::memory_order_release);
+      threads[index].tid.store(0, std::memory_order_release);
+    }
+  }
+};
+}  // namespace
+
+void EnableHealth(bool value) { enabled.store(value, std::memory_order_relaxed); }
+void HealthRecord(HealthEvent event, uint64_t detail) {
+  if (!enabled.load(std::memory_order_relaxed)) return;
+  auto& metric = metrics[size_t(event)];
+  metric.detail.store(detail, std::memory_order_relaxed);
+  metric.last.store(Now(), std::memory_order_relaxed);
+  metric.count.fetch_add(1, std::memory_order_release);
+}
+HealthScope::HealthScope(const char* label, uint64_t detail) {
+  if (!enabled.load(std::memory_order_relaxed)) return;
+  static thread_local Registration registration;
+  slot_ = registration.index;
+  if (slot_ < 0) return;
+  auto& slot = threads[slot_];
+  previous_label_ = slot.label.load(std::memory_order_relaxed);
+  previous_started_ = slot.started.load(std::memory_order_relaxed);
+  previous_detail_ = slot.detail.load(std::memory_order_relaxed);
+  previous_lr_ = slot.lr.load(std::memory_order_relaxed);
+  auto* state = runtime::ThreadState::Get();
+  slot.guest.store(state ? state->thread_id() : 0, std::memory_order_relaxed);
+  slot.lr.store(state ? uint32_t(state->context()->lr) : 0, std::memory_order_relaxed);
+  slot.detail.store(detail, std::memory_order_relaxed);
+  slot.started.store(Now(), std::memory_order_relaxed);
+  slot.label.store(label, std::memory_order_release);
+}
+HealthScope::~HealthScope() {
+  if (slot_ < 0) return;
+  auto& slot = threads[slot_];
+  slot.detail.store(previous_detail_, std::memory_order_relaxed);
+  slot.started.store(previous_started_, std::memory_order_relaxed);
+  slot.lr.store(previous_lr_, std::memory_order_relaxed);
+  slot.label.store(previous_label_, std::memory_order_release);
+}
+std::string HealthSummary() {
+  const uint64_t now = Now();
+  std::ostringstream out;
+  out << "t_ms=" << now / 1000000;
+  for (size_t i = 0; i < metrics.size(); ++i) {
+    auto& metric = metrics[i];
+    const uint64_t count = metric.count.load(std::memory_order_acquire);
+    const uint64_t last = metric.last.load(std::memory_order_relaxed);
+    out << ' ' << names[i] << '=' << count << '/';
+    if (last && now >= last) out << (now - last) / 1000000;
+    else out << '-';
+  }
+  return out.str();
+}
+std::string HealthThreads() {
+  const uint64_t now = Now();
+  std::ostringstream out;
+  for (auto& slot : threads) {
+    const char* label = slot.label.load(std::memory_order_acquire);
+    const uint32_t tid = slot.tid.load(std::memory_order_acquire);
+    if (!label || !tid) continue;
+    const uint64_t started = slot.started.load(std::memory_order_relaxed);
+    out << " tid=" << tid << " guest=" << slot.guest.load()
+        << " stage=" << label << " age_ms="
+        << (now >= started ? (now - started) / 1000000 : 0)
+        << " detail=0x" << std::hex << slot.detail.load()
+        << " lr=0x" << slot.lr.load() << std::dec << '\n';
+  }
+  // Fields are atomic observations, not a frozen, transactional thread dump.
+  return out.str();
+}
+}  // namespace rex::diagnostics
