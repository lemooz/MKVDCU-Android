@@ -0,0 +1,36 @@
+#pragma once
+#include <cstdint>
+#include <string>
+#include <rex/diagnostics/health.h>
+namespace rex::diagnostics {
+enum class PerformanceStage : uint32_t {
+  DrawCpu, ShaderTranslation, PipelineCreation, TextureUpload, ResolveCpu,
+  SubmissionCpu, FenceWait, GpuSubmission, GpuDraw, GpuRtDump, GpuResolve, GpuTextureUpload,
+  OcclusionReadbackCpu, SubmissionRetirementCpu, QueueAcquireCpu, QueueSubmitCpu,
+  SubmissionReplayCpu, PipelineWaitCpu, WaitFrameThrottle, WaitMemexport,
+  WaitResolve, WaitOcclusion, WaitDiagnostic, WaitDescriptorReuse, WaitExplicitSync,
+  PresentNativeFenceCpu, PresentReadyWaitCpu, PresentQueueAcquireCpu, PresentCallCpu, Count
+};
+enum class GraphicsMetric : uint32_t {
+  QueueSubmissions, RenderPassBegins, ResolveCommands, TextureCacheHits,
+  TextureCacheMisses, TextureCacheCreates, TextureCacheEvictions,
+  TextureUploadsQueued, TextureUploadGuestBytes, Count
+};
+REX_HEALTH_API void EnablePerformance(bool enabled);
+REX_HEALTH_API void RecordPerformance(PerformanceStage stage, uint64_t nanoseconds);
+REX_HEALTH_API std::string PerformanceSummary();
+REX_HEALTH_API bool PerformanceEnabled();
+REX_HEALTH_API const char* PerformanceStageName(PerformanceStage stage);
+struct PerformanceTotals { uint64_t count, nanoseconds; };
+REX_HEALTH_API PerformanceTotals ReadPerformance(PerformanceStage stage);
+REX_HEALTH_API void RecordGraphicsMetric(GraphicsMetric metric, uint64_t amount = 1);
+REX_HEALTH_API uint64_t ReadGraphicsMetric(GraphicsMetric metric);
+class REX_HEALTH_API PerformanceScope {
+ public:
+  explicit PerformanceScope(PerformanceStage stage);
+  ~PerformanceScope();
+ private:
+  PerformanceStage stage_;
+  uint64_t started_ = 0;
+};
+}  // namespace rex::diagnostics
