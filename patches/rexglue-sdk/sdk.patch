+extern "C" JNIEXPORT jstring JNICALL
+Java_org_mkvdcu_android_DriverNative_configure(JNIEnv* env, jclass, jstring jkind,
+    jstring jdir, jstring jlibrary, jstring jhooks, jstring jtmp, jstring jid,
+    jstring jcache, jobjectArray jdependencies, jboolean jdisable_lossy_afrc, jint jturnip_mode,
+    jboolean jpanvk_late_stencil) {
+  std::lock_guard lock(mutex);
+  if (frozen) return env->NewStringUTF("O driver já está inicializado; reinicie a sessão");
+  const auto candidate_kind = JString(env, jkind);
+  if (candidate_kind != "system" && candidate_kind != "turnip" && candidate_kind != "panvk" && candidate_kind != "adreno")
+    return env->NewStringUTF("Tipo de driver inválido");
+  const auto candidate_lib = JString(env, jlibrary);
+  if (candidate_kind != "system" && (candidate_lib.empty() ||
+      candidate_lib.find('/') != std::string::npos || candidate_lib.find('\\') != std::string::npos))
+    return env->NewStringUTF("Nome de biblioteca inválido");
+  kind = candidate_kind;
+  if (jturnip_mode < 0 || jturnip_mode > 2) return env->NewStringUTF("Modo Turnip inválido");
+  turnip_mode = kind == "turnip" ? jturnip_mode : 0;
+  panvk_late_stencil = kind == "panvk" && jpanvk_late_stencil;
+  disable_lossy_afrc = kind == "panvk" && jdisable_lossy_afrc;
+  directory = JString(env, jdir); library = candidate_lib;
+  hooks = JString(env, jhooks); temporary = JString(env, jtmp); package_id = JString(env, jid);
+  mesa_cache = JString(env, jcache);
+  if (kind != "system" && (mesa_cache.empty() || package_id.size() != 64 ||
+      package_id.find_first_not_of("0123456789abcdef") != std::string::npos))
+    return env->NewStringUTF("Cache ou identidade do pacote inválidos");
+  dependencies.clear();
+  if (jdependencies) {
+    const jsize count = env->GetArrayLength(jdependencies);
+    if (count > 128) return env->NewStringUTF("Dependências excessivas");
+    for (jsize i = 0; i < count; ++i) {
+      auto value = static_cast<jstring>(env->GetObjectArrayElement(jdependencies, i));
+      auto dependency = JString(env, value);
+      env->DeleteLocalRef(value);
+      if (dependency.empty() || dependency == "." || dependency == ".." ||
+          dependency.find_first_not_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_+.-") != std::string::npos)
+        return env->NewStringUTF("Nome de dependência inválido");
+      dependencies.push_back(std::move(dependency));
+    }
+  }
+  return env->NewStringUTF("");
+}
+extern "C" JNIEXPORT jstring JNICALL
+Java_org_mkvdcu_android_DriverNative_configureCpuLimit(JNIEnv* env, jclass, jint requested,
+                                                     jboolean economy) {
+  // Called only in :game, before Vulkan/SDL/guest workers are created. Imported
+  // driver workers inherit their parent's mask. The launcher/probe stay free.
+  if (requested < 0 || requested > 64) return env->NewStringUTF("Invalid CPU count; Android scheduler retained");
+  if (!requested) {
+    unsetenv("MKVDCU_ANDROID_CPU_MASK");
+    return env->NewStringUTF("CPU: automatic (Android scheduler)");
+  }
+  cpu_set_t available;
+  CPU_ZERO(&available);
+  if (sched_getaffinity(0, sizeof(available), &available))
+    return env->NewStringUTF("CPU: unable to read allowed CPUs; Android scheduler retained");
+  struct Cpu { int id, capacity; };
+  std::vector<Cpu> cpus;
+  bool capacities_known = true;
+  for (int i = 0; i < 64; ++i) if (CPU_ISSET(i, &available)) {
+    int capacity = 0;
+    std::ifstream("/sys/devices/system/cpu/cpu" + std::to_string(i) + "/cpu_capacity") >> capacity;
+    capacities_known &= capacity > 0;
+    cpus.push_back({i, capacity});
+  }
+  if (cpus.empty()) return env->NewStringUTF("CPU: empty allowed mask; Android scheduler retained");
+  if (capacities_known) std::stable_sort(cpus.begin(), cpus.end(), [economy](const Cpu& a, const Cpu& b) {
+    return economy ? a.capacity < b.capacity : a.capacity > b.capacity;
+  });
+  const size_t count = std::min(size_t(requested), cpus.size());
+  cpu_set_t selected;
+  CPU_ZERO(&selected);
+  uint64_t mask = 0;
+  for (size_t i = 0; i < count; ++i) { CPU_SET(cpus[i].id, &selected); mask |= UINT64_C(1) << cpus[i].id; }
+  if (sched_setaffinity(0, sizeof(selected), &selected))
+    return env->NewStringUTF("CPU: affinity request rejected; Android scheduler retained");
+  // Android cpusets may silently intersect the requested mask. Persist and
+  // report the effective mask, rather than a count the kernel did not grant.
+  cpu_set_t effective;
+  CPU_ZERO(&effective);
+  if (sched_getaffinity(0, sizeof(effective), &effective)) {
+    sched_setaffinity(0, sizeof(available), &available);
+    return env->NewStringUTF("CPU: unable to confirm affinity; original mask restored");
+  }
+  mask = 0;
+  size_t effective_count = 0;
+  for (int i = 0; i < 64; ++i) if (CPU_ISSET(i, &effective)) {
+    mask |= UINT64_C(1) << i;
+    ++effective_count;
+  }
+  selected = effective;
+  std::ostringstream encoded; encoded << std::hex << mask;
+  if (setenv("MKVDCU_ANDROID_CPU_MASK", encoded.str().c_str(), 1)) {
+    sched_setaffinity(0, sizeof(available), &available);
+    return env->NewStringUTF("CPU: policy could not be stored; original mask restored");
+  }
+  size_t failed = 0;
+  std::error_code ec;
+  // Java/ART threads already exist. Restrict this dedicated process as well,
+  // so subsequent runtime and imported-driver workers inherit the same limit.
+  std::filesystem::directory_iterator thread("/proc/self/task", ec), end_thread;
+  for (; !ec && thread != end_thread; thread.increment(ec)) {
+    const auto name = thread->path().filename().string();
+    char* end = nullptr; const long tid = std::strtol(name.c_str(), &end, 10);
+    if (end && !*end && tid > 0 && sched_setaffinity(pid_t(tid), sizeof(selected), &selected) && errno != ESRCH) ++failed;
+  }
+  const std::string summary = "CPU: requested=" + std::to_string(requested) + " allowed=" +
+      std::to_string(cpus.size()) + " selected=" + std::to_string(count) + " effective=" + std::to_string(effective_count) + " mask=0x" + encoded.str() +
+      " capacity_ranked=" + std::to_string(capacities_known) + " economy=" + std::to_string(bool(economy)) +
+      " thread_failures=" + std::to_string(failed) + " enumeration_error=" + std::to_string(ec.value());
+  REXLOG_INFO("[CPU_POLICY] {}", summary);
+  return env->NewStringUTF(summary.c_str());
+}
+extern "C" JNIEXPORT jstring JNICALL
+Java_org_mkvdcu_android_DriverNative_identity(JNIEnv* env, jclass) {
+  return env->NewStringUTF(AndroidDriverIdentity().c_str());
+}
