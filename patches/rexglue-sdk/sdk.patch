+    invalidate.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+    invalidate.memory = memory;
+    invalidate.size = VK_WHOLE_SIZE;
+    if (dfn.vkInvalidateMappedMemoryRanges(vk_device, 1, &invalidate) == VK_SUCCESS) {
+      const std::filesystem::path root = "/data/user/0/org.mkvdcu.android/files/frameprobe_draws";
+      std::error_code ec;
+      std::filesystem::create_directories(root, ec);
+      for (const auto& range : ranges) {
+        const auto* bytes = static_cast<const uint8_t*>(mapped) + range.offset;
+        const auto path = root / fmt::format("e{}_f{}_d{}_{}_{}_{:08X}.gpu.bin",
+            FrameCaptureEpoch(), GetCurrentFrame(), draw_id, range.kind, range.slot, range.physical);
+        uint64_t hash = UINT64_C(1469598103934665603), nonzero = 0;
+        for (uint32_t i = 0; i < range.copied; ++i) {
+          hash = (hash ^ bytes[i]) * UINT64_C(1099511628211);
+          nonzero += bytes[i] != 0;
+        }
+        bool saved = false;
+        if (!ec) {
+          if (FILE* output = std::fopen(path.string().c_str(), "wb")) {
+            saved = std::fwrite(bytes, 1, range.copied, output) == range.copied;
+            const int closed = std::fclose(output);
+            saved = saved && closed == 0;
+          }
+        }
+        REXLOG_INFO("[FRAMEPROBE][DRAW_BUFFER] capture={} frame={} draw={} kind={} slot={} "
+                    "address=0x{:08X} physical=0x{:08X} aligned=0x{:08X} requested={} copied={} "
+                    "endian={} format={} nonZero={} checksum=0x{:016X} path={} saved={} "
+                    "source_buffer=0x{:X} source_offset={} prefix={} scope=GPU_after_draw_no_memexport",
+                    FrameCaptureEpoch(), GetCurrentFrame(), draw_id, range.kind, range.slot,
+                    range.address, range.physical, range.physical & ~UINT32_C(3),
+                    range.requested, range.copied, range.endian, range.format, nonzero, hash,
+                    path.string(), saved, uint64_t(range.source), range.source_offset,
+                    range.physical & 3);
+      }
+    } else {
+      REXLOG_ERROR("[FRAMEPROBE][DRAW_BUFFER] draw={} invalidate failed", draw_id);
+    }
+    dfn.vkUnmapMemory(vk_device, memory);
+  } else {
+    REXLOG_ERROR("[FRAMEPROBE][DRAW_BUFFER] draw={} map failed", draw_id);
+  }
+  dfn.vkDestroyBuffer(vk_device, staging, nullptr);
+  dfn.vkFreeMemory(vk_device, memory, nullptr);
+  return BeginSubmission(true);
+#else
+  return true;
+#endif
+}
+
+bool VulkanRenderTargetCache::ProbeBoundColorForDraw(uint64_t probe_id) {
+#ifdef __ANDROID__
+  if (GetPath() != Path::kHostRenderTargets || !command_processor_.submission_open()) return false;
+  auto* target = last_update_accumulated_render_targets()[1];
+  if (!target || target->key().is_depth) return false;
+  const auto saved_id = frame_probe_resolve_ordinal_;
+  const auto saved_address = frame_probe_resolve_address_;
+  frame_probe_resolve_ordinal_ = probe_id;
+  frame_probe_resolve_address_ = 0;  // This is a draw attachment, not Resolve output.
+  const auto key = target->key();
+  const bool result = ProbeRenderTargetForResolve(*target, key.base_tiles,
+      key.pitch_tiles_at_32bpp, key.pitch_tiles_at_32bpp);
+  frame_probe_resolve_ordinal_ = saved_id;
+  frame_probe_resolve_address_ = saved_address;
+  return result;
+#else
+  return false;
+#endif
+}
+
+bool VulkanRenderTargetCache::ProbeRenderTargetForResolve(RenderTarget& render_target,
+                                                          uint32_t dump_base,
+                                                          uint32_t dump_row_length,
+                                                          uint32_t dump_pitch) {
+#ifdef __ANDROID__
+  auto& rt = static_cast<VulkanRenderTarget&>(render_target);
+  const auto key = rt.key();
+  if (key.is_depth || !rt.probe_transfer_supported() ||
+      rt.current_layout() == VK_IMAGE_LAYOUT_UNDEFINED) {
+    REXLOG_WARN("[FRAMEPROBE][RT] id={} base={} unavailable depth={} transfer={} layout={}",
+                frame_probe_resolve_ordinal_, uint32_t(key.base_tiles), bool(key.is_depth),
+                rt.probe_transfer_supported(), int(rt.current_layout()));
+    return true;  // Unavailable is not a measurement of zero pixels.
+  }
+  const auto* device = command_processor_.GetVulkanDevice();
+  const auto& dfn = device->functions();
+  const VkDevice vk_device = device->device();
+  const VkFormat format = GetColorVulkanFormat(key.GetColorFormat());
+  uint32_t bpp;
+  switch (format) {
+    case VK_FORMAT_R16G16B16A16_UNORM:
+    case VK_FORMAT_R16G16B16A16_SNORM:
+    case VK_FORMAT_R16G16B16A16_SFLOAT:
+    case VK_FORMAT_R32G32_SFLOAT:
+      bpp = 8;
+      break;
+    case VK_FORMAT_R8G8B8A8_UNORM:
+    case VK_FORMAT_A8B8G8R8_UNORM_PACK32:
+    case VK_FORMAT_A2B10G10R10_UNORM_PACK32:
+    case VK_FORMAT_R16G16_SFLOAT:
+    case VK_FORMAT_R16G16_SNORM:
+    case VK_FORMAT_R32_SFLOAT:
+      bpp = 4;
+      break;
+    default:
+      REXLOG_WARN("[FRAMEPROBE][RT] id={} unsupported format={}", frame_probe_resolve_ordinal_,
+                  int(format));
+      return true;
+  }
+  const uint32_t width = key.GetWidth() * draw_resolution_scale_x();
+  const uint32_t height =
+      GetRenderTargetHeight(key.pitch_tiles_at_32bpp, key.msaa_samples) * draw_resolution_scale_y();
+  const VkDeviceSize size = VkDeviceSize(width) * height * bpp;
+  const bool multisampled = key.msaa_samples != xenos::MsaaSamples::k1X;
+  VkBuffer staging = VK_NULL_HANDLE;
+  VkDeviceMemory staging_memory = VK_NULL_HANDLE;
+  VkImage resolved = VK_NULL_HANDLE;
+  VkDeviceMemory resolved_memory = VK_NULL_HANDLE;
+  auto cleanup = [&]() {
+    if (staging)
+      dfn.vkDestroyBuffer(vk_device, staging, nullptr);
+    if (staging_memory)
+      dfn.vkFreeMemory(vk_device, staging_memory, nullptr);
+    if (resolved)
+      dfn.vkDestroyImage(vk_device, resolved, nullptr);
+    if (resolved_memory)
+      dfn.vkFreeMemory(vk_device, resolved_memory, nullptr);
+  };
+  if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+          device, size, VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+          ui::vulkan::util::MemoryPurpose::kReadback, staging, staging_memory)) {
+    REXGPU_ERROR("[FRAMEPROBE][RT] staging allocation failed");
+    return false;
+  }
+  if (multisampled) {
+    VkImageCreateInfo info = {};
+    info.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+    info.imageType = VK_IMAGE_TYPE_2D;
+    info.format = format;
+    info.extent = {width, height, 1};
+    info.mipLevels = info.arrayLayers = 1;
+    info.samples = VK_SAMPLE_COUNT_1_BIT;
+    info.tiling = VK_IMAGE_TILING_OPTIMAL;
+    info.usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    if (!ui::vulkan::util::CreateDedicatedAllocationImage(
+            device, info, ui::vulkan::util::MemoryPurpose::kDeviceLocal, resolved,
+            resolved_memory)) {
+      cleanup();
+      REXGPU_ERROR("[FRAMEPROBE][RT] MSAA resolve image allocation failed");
+      return false;
+    }
+  }
+  const auto range = ui::vulkan::util::InitializeSubresourceRange(VK_IMAGE_ASPECT_COLOR_BIT);
+  auto& commands = command_processor_.deferred_command_buffer();
+  command_processor_.PushImageMemoryBarrier(
+      rt.image(), range, rt.current_stage_mask(), VK_PIPELINE_STAGE_TRANSFER_BIT,
+      rt.current_access_mask(), VK_ACCESS_TRANSFER_READ_BIT, rt.current_layout(),
+      VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  if (multisampled) {
+    command_processor_.PushImageMemoryBarrier(
+        resolved, range, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0,
+        VK_ACCESS_TRANSFER_WRITE_BIT, VK_IMAGE_LAYOUT_UNDEFINED,
+        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+  }
+  // End the render pass, including its STORE operations, before copying.
+  command_processor_.SubmitBarriers(true);
+  if (multisampled) {
+    VkImageResolve region = {};
+    region.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    region.dstSubresource = region.srcSubresource;
+    region.extent = {width, height, 1};
+    commands.CmdVkResolveImage(rt.image(), resolved, region);
+    command_processor_.PushImageMemoryBarrier(
+        resolved, range, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+        VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    command_processor_.SubmitBarriers(true);
+  }
+  VkBufferImageCopy region = {};
+  region.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  region.imageExtent = {width, height, 1};
+  commands.CmdVkCopyImageToBuffer(multisampled ? resolved : rt.image(),
+                                  VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, staging, 1, &region);
+  command_processor_.PushBufferMemoryBarrier(staging, 0, size, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                                             VK_PIPELINE_STAGE_HOST_BIT,
+                                             VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_HOST_READ_BIT);
+  command_processor_.PushImageMemoryBarrier(
+      rt.image(), range, VK_PIPELINE_STAGE_TRANSFER_BIT, rt.current_stage_mask(),
+      VK_ACCESS_TRANSFER_READ_BIT, rt.current_access_mask(), VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+      rt.current_layout());
+  command_processor_.SubmitBarriers(true);
+  const uint64_t submission = command_processor_.GetCurrentSubmission();
+  if (!command_processor_.AwaitAllQueueOperationsCompletion(rex::diagnostics::PerformanceStage::WaitDiagnostic)) {
+    // No fence completion: do not read or free resources still referenced by
+    // the queue. Normal deferred destruction owns them from this point.
+    command_processor_.destroy_buffers_.emplace_back(submission, staging);
+    command_processor_.destroy_memory_.emplace_back(submission, staging_memory);
+    if (resolved)
+      command_processor_.destroy_images_.emplace_back(submission, resolved);
+    if (resolved_memory)
+      command_processor_.destroy_memory_.emplace_back(submission, resolved_memory);
+    REXGPU_ERROR("[FRAMEPROBE][RT] id={} queue wait failed", frame_probe_resolve_ordinal_);
+    return false;
+  }
+  void* mapping = nullptr;
+  if (dfn.vkMapMemory(vk_device, staging_memory, 0, VK_WHOLE_SIZE, 0, &mapping) == VK_SUCCESS) {
+    VkMappedMemoryRange mapped_range = {};
+    mapped_range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+    mapped_range.memory = staging_memory;
+    mapped_range.size = VK_WHOLE_SIZE;
+    if (dfn.vkInvalidateMappedMemoryRanges(vk_device, 1, &mapped_range) == VK_SUCCESS) {
+      const auto* bytes = static_cast<const uint8_t*>(mapping);
+      uint64_t hash = 1469598103934665603ull, nonzero = 0;
+      uint8_t minimum = 255, maximum = 0;
+      for (VkDeviceSize i = 0; i < size; ++i) {
+        hash = (hash ^ bytes[i]) * 1099511628211ull;
+        nonzero += bytes[i] != 0;
+        minimum = std::min(minimum, bytes[i]);
+        maximum = std::max(maximum, bytes[i]);
+      }
+      // Follow exactly the tile ownership and dispatch mapping used by Dump,
+      // excluding unrelated / uninitialized portions of the large attachment.
+      const uint32_t tile_width =
+          (xenos::kEdramTileWidthSamples >>
+           (uint32_t(key.Is64bpp()) + uint32_t(key.msaa_samples >= xenos::MsaaSamples::k4X))) *
+          draw_resolution_scale_x();
+      const uint32_t tile_height =
+          (xenos::kEdramTileHeightSamples >> uint32_t(multisampled)) * draw_resolution_scale_y();
+      uint64_t source_bytes = 0, source_nonzero = 0, source_hash = 1469598103934665603ull;
+      uint64_t out_of_bounds_tiles = 0, varying_pixels = 0, rgb_nonzero = 0;
+      uint64_t rgb_over_16 = 0, rgb_over_64 = 0, rgb_over_128 = 0;
+      uint8_t max_r = 0, max_g = 0, max_b = 0;
+      uint32_t min_x = width, min_y = height, max_x = 0, max_y = 0;
+      uint8_t first_pixel[8] = {};
+      uint8_t rgb_samples[8][4] = {};
+      uint32_t rgb_sample_count = 0;
+      bool have_first_pixel = false;
+      const bool rgba8 = format == VK_FORMAT_R8G8B8A8_UNORM ||
+                         format == VK_FORMAT_A8B8G8R8_UNORM_PACK32;
+      for (const auto& rectangle : dump_rectangles_) {
+        if (rectangle.render_target != &render_target)
+          continue;
+        ResolveCopyDumpRectangle::Dispatch dispatches[ResolveCopyDumpRectangle::kMaxDispatches];
+        const uint32_t count = rectangle.GetDispatches(dump_pitch, dump_row_length, dispatches);
+        for (uint32_t d = 0; d < count; ++d) {
+          const auto& dispatch = dispatches[d];
+          for (uint32_t y = 0; y < dispatch.height_tiles; ++y) {
+            for (uint32_t x = 0; x < dispatch.width_tiles; ++x) {
+              const uint32_t tile =
+                  dump_base + dispatch.offset + y * dump_pitch + x - key.base_tiles;
+              const uint32_t px = (tile % key.GetPitchTiles()) * tile_width;
+              const uint32_t py = (tile / key.GetPitchTiles()) * tile_height;
+              if (uint64_t(px) + tile_width > width || uint64_t(py) + tile_height > height) {
+                ++out_of_bounds_tiles;
+                continue;
+              }
+              for (uint32_t row = 0; row < tile_height; ++row) {
+                const auto* row_bytes = bytes + (VkDeviceSize(py + row) * width + px) * bpp;
+                for (uint32_t pixel = 0; pixel < tile_width; ++pixel) {
+                  const uint8_t* value = row_bytes + pixel * bpp;
+                  if (!have_first_pixel) {
+                    std::memcpy(first_pixel, value, bpp);
+                    have_first_pixel = true;
+                  }
+                  varying_pixels += std::memcmp(first_pixel, value, bpp) != 0;
+                  if (rgba8) {
+                    const bool has_rgb = (value[0] | value[1] | value[2]) != 0;
+                    rgb_nonzero += has_rgb;
+                    const uint8_t peak = std::max(value[0], std::max(value[1], value[2]));
+                    rgb_over_16 += peak > 16;
+                    rgb_over_64 += peak > 64;
+                    rgb_over_128 += peak > 128;
+                    max_r = std::max(max_r, value[0]);
+                    max_g = std::max(max_g, value[1]);
+                    max_b = std::max(max_b, value[2]);
+                    if (has_rgb) {
+                      min_x = std::min(min_x, px + pixel);
+                      min_y = std::min(min_y, py + row);
+                      max_x = std::max(max_x, px + pixel);
+                      max_y = std::max(max_y, py + row);
+                    }
+                    if (has_rgb && rgb_sample_count < 8) {
+                      std::memcpy(rgb_samples[rgb_sample_count++], value, 4);
+                    }
+                  }
+                }
+                for (uint32_t byte = 0; byte < tile_width * bpp; ++byte) {
+                  source_hash = (source_hash ^ row_bytes[byte]) * 1099511628211ull;
+                  source_nonzero += row_bytes[byte] != 0;
+                }
+                source_bytes += tile_width * bpp;
+              }
+            }
+          }
+        }
+      }
+      REXLOG_INFO(
+          "[FRAMEPROBE][RT] id={} frame={} resolve=0x{:08X} base={} pitch={} "
+          "format={} width={} height={} bytes={} msaa_resolved={} nonZero={} "
+          "image=0x{:X} key=0x{:08X} msaa={} "
+          "min={} max={} checksum=0x{:016X} scope=whole_attachment",
+          frame_probe_resolve_ordinal_, command_processor_.GetCurrentFrame(),
+          frame_probe_resolve_address_, uint32_t(key.base_tiles), key.GetPitchTiles(), int(format), width,
+          height, size, multisampled, nonzero, uint64_t(rt.image()), key.key,
+          uint32_t(key.msaa_samples), minimum, maximum, hash);
+      REXLOG_INFO(
+          "[FRAMEPROBE][RT_SOURCE] id={} base={} bytes={} nonZero={} "
+          "checksum=0x{:016X} out_of_bounds_tiles={} msaa_resolved={}",
+          frame_probe_resolve_ordinal_, uint32_t(key.base_tiles), source_bytes, source_nonzero, source_hash,
+          out_of_bounds_tiles, multisampled);
+      REXLOG_INFO("[FRAMEPROBE][RT_PIXELS] id={} base={} varying_pixels={} "
+                  "rgb_count_available={} rgb_nonzero_pixels={} first_pixel={:02X}{:02X}{:02X}{:02X} "
+                  "rgb_samples={:02X}{:02X}{:02X}{:02X},{:02X}{:02X}{:02X}{:02X},"
+                  "{:02X}{:02X}{:02X}{:02X},{:02X}{:02X}{:02X}{:02X}",
+                  frame_probe_resolve_ordinal_, uint32_t(key.base_tiles), varying_pixels,
+                  rgba8, rgb_nonzero, first_pixel[0], first_pixel[1], first_pixel[2], first_pixel[3],
+                  rgb_samples[0][0], rgb_samples[0][1], rgb_samples[0][2], rgb_samples[0][3],
+                  rgb_samples[1][0], rgb_samples[1][1], rgb_samples[1][2], rgb_samples[1][3],
+                  rgb_samples[2][0], rgb_samples[2][1], rgb_samples[2][2], rgb_samples[2][3],
+                  rgb_samples[3][0], rgb_samples[3][1], rgb_samples[3][2], rgb_samples[3][3]);
+      REXLOG_INFO("[FRAMEPROBE][RT_RGB] id={} max_rgb={},{},{} over16={} over64={} over128={} "
+                  "bounds={}..{},{}..{}",
+                  frame_probe_resolve_ordinal_, max_r, max_g, max_b, rgb_over_16, rgb_over_64,
+                  rgb_over_128, rgb_nonzero ? min_x : 0, rgb_nonzero ? max_x : 0,
+                  rgb_nonzero ? min_y : 0, rgb_nonzero ? max_y : 0);
+      // Preserve one synchronized color attachment before DumpRenderTargets
+      // / EDRAM resolve can modify or reinterpret it.
+      if ((frame_probe_resolve_ordinal_ == 128 || FrameCaptureManual()) && rgba8) {
+        const std::string probe_path = FrameCaptureManual() ? fmt::format(
+            "/data/user/0/org.mkvdcu.android/files/frameprobe_rt_{}_{}_{:X}.tga",
+            FrameCaptureEpoch(), frame_probe_resolve_ordinal_, uint32_t(key.base_tiles)) :
+            "/data/user/0/org.mkvdcu.android/files/frameprobe_rt128.tga";
+        if (FILE* image = std::fopen(probe_path.c_str(), "wb")) {
+          // Uncompressed top-left-origin TGA preserves alpha as well as RGB.
+          // GPU image limits bound the dimensions to the 16-bit TGA fields.
+          const uint8_t header[18] = {0, 0, 2, 0, 0, 0, 0, 0, 0, 0, 0, 0,
+              uint8_t(width), uint8_t(width >> 8), uint8_t(height), uint8_t(height >> 8), 32, 0x28};
+          std::fwrite(header, 1, sizeof(header), image);
+          std::vector<uint8_t> bgra_row(size_t(width) * 4);
+          for (uint32_t y = 0; y < height; ++y) {
+            const uint8_t* row = bytes + VkDeviceSize(y) * width * bpp;
+            for (uint32_t x = 0; x < width; ++x) {
+              const uint8_t* pixel = row + VkDeviceSize(x) * bpp;
+              uint8_t* output = bgra_row.data() + size_t(x) * 4;
+              output[0] = pixel[2]; output[1] = pixel[1];
+              output[2] = pixel[0]; output[3] = pixel[3];
+            }
+            std::fwrite(bgra_row.data(), 1, bgra_row.size(), image);
+          }
+          const bool saved = std::fclose(image) == 0;
+          REXLOG_INFO("[FRAMEPROBE][RT_IMAGE] id={} path={} saved={} width={} height={}",
+                      frame_probe_resolve_ordinal_, probe_path, saved, width, height);
+        } else {
+          REXLOG_WARN("[FRAMEPROBE][RT_IMAGE] cannot open {}", probe_path);
+        }
+      }
+      const auto& draws = command_processor_.frame_probe_draws_;
+      REXLOG_INFO(
+          "[FRAMEPROBE][DRAW_TOTALS] id={} requested={} prepared={} pipeline_ready={} "
+          "pipeline_bound={} emitted={} vkCmdDraw_replayed={} skipped={} failed={} memexport_vs={}",
+          frame_probe_resolve_ordinal_, draws.requested, draws.prepared, draws.pipeline_ready,
+          draws.pipeline_bound, draws.emitted, commands.guest_draws_replayed(), draws.skipped,
+          draws.failed, draws.vertex_memexport);
+    } else {
+      REXGPU_ERROR("[FRAMEPROBE][RT] invalidate failed");
+    }
+    dfn.vkUnmapMemory(vk_device, staging_memory);
+  } else {
+    REXGPU_ERROR("[FRAMEPROBE][RT] map failed");
+  }
+  cleanup();
+  return command_processor_.BeginSubmission(true);
+#else
+  return true;
+#endif
+}
+
+bool VulkanRenderTargetCache::ProbeEdramForResolve(uint32_t resolve_address, uint32_t dump_base,
+                                                   uint32_t dump_row_length, uint32_t dump_rows,
+                                                   uint32_t dump_pitch) {
+#ifdef __ANDROID__
+  const uint64_t size =
+      uint64_t(xenos::kEdramSizeBytes) * draw_resolution_scale_x() * draw_resolution_scale_y();
+  const ui::vulkan::VulkanDevice* const device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = device->functions();
+  const VkDevice vk_device = device->device();
+  VkBuffer staging_buffer = VK_NULL_HANDLE;
+  VkDeviceMemory staging_memory = VK_NULL_HANDLE;
+  if (size > UINT32_MAX ||
+      !ui::vulkan::util::CreateDedicatedAllocationBuffer(
+          device, size, VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+          ui::vulkan::util::MemoryPurpose::kReadback, staging_buffer, staging_memory)) {
+    REXGPU_ERROR("[FRAMEPROBE][EDRAM] staging allocation failed size={}", size);
+    return false;
+  }
+
+  void* mapping = nullptr;
+  if (dfn.vkMapMemory(vk_device, staging_memory, 0, VK_WHOLE_SIZE, 0, &mapping) != VK_SUCCESS) {
+    REXGPU_ERROR("[FRAMEPROBE][EDRAM] staging map failed");
+  } else {
+    // The resolve's source writes and this copy share the same deferred queue.
+    // The transitions make the tracked buffer usage explicit; the fence wait
+    // below completes the copy before the CPU examines the invalidated mapping.
+    UseEdramBuffer(EdramBufferUsage::kTransferRead);
+    command_processor_.SubmitBarriers(true);
+    VkBufferCopy copy = {};
+    copy.size = size;
+    command_processor_.deferred_command_buffer().CmdVkCopyBuffer(edram_buffer_, staging_buffer, 1,
+                                                                 &copy);
+    command_processor_.PushBufferMemoryBarrier(
+        staging_buffer, 0, size, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT,
+        VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_HOST_READ_BIT);
+    UseEdramBuffer(EdramBufferUsage::kComputeRead);
+    command_processor_.SubmitBarriers(true);
+
+    if (command_processor_.AwaitAllQueueOperationsCompletion(rex::diagnostics::PerformanceStage::WaitDiagnostic)) {
+      VkMappedMemoryRange range = {};
+      range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+      range.memory = staging_memory;
+      range.offset = 0;
+      range.size = VK_WHOLE_SIZE;
+      const VkResult invalidate = dfn.vkInvalidateMappedMemoryRanges(vk_device, 1, &range);
+      if (invalidate == VK_SUCCESS) {
+        const auto* bytes = static_cast<const uint8_t*>(mapping);
+        uint64_t whole_hash = 1469598103934665603ull;
+        uint64_t whole_nonzero = 0;
+        for (uint64_t i = 0; i < size; ++i) {
+          whole_hash = (whole_hash ^ bytes[i]) * 1099511628211ull;
+          whole_nonzero += bytes[i] != 0;
+        }
+
+        // The current frontbuffer resolve is 32bpp. ResolveInfo reports the
+        // exact EDRAM tile rectangle consumed by its dump/resolve operation.
+        const uint32_t tile_count = xenos::kEdramTileCount;
+        const uint32_t tile_size = uint32_t(size / tile_count);
+        const uint32_t first_tile = dump_base % tile_count;
+        uint64_t source_hash = 1469598103934665603ull;
+        uint64_t source_nonzero = 0;
+        uint64_t source_size = 0;
+        for (uint32_t row = 0; row < dump_rows; ++row) {
+          for (uint32_t column = 0; column < dump_row_length; ++column) {
+            const uint32_t tile = (first_tile + row * dump_pitch + column) % tile_count;
+            const uint64_t begin = uint64_t(tile) * tile_size;
+            for (uint32_t i = 0; i < tile_size; ++i) {
+              const uint8_t value = bytes[begin + i];
+              source_hash = (source_hash ^ value) * 1099511628211ull;
+              source_nonzero += value != 0;
+            }
+            source_size += tile_size;
+          }
+        }
+        REXLOG_INFO(
+            "[FRAMEPROBE][EDRAM] id={} resolve=0x{:08X} size={} dump_base={} "
+            "row_tiles={} rows={} pitch_tiles={} whole_nonZero={} "
+            "whole_checksum=0x{:016X} source_bytes={} source_nonZero={} "
+            "source_checksum=0x{:016X} source_first16={:02X}{:02X}{:02X}{:02X}"
+            "{:02X}{:02X}{:02X}{:02X}{:02X}{:02X}{:02X}{:02X}{:02X}{:02X}{:02X}{:02X}",
+            frame_probe_resolve_ordinal_, resolve_address, size, dump_base, dump_row_length,
+            dump_rows, dump_pitch, whole_nonzero, whole_hash, source_size, source_nonzero,
+            source_hash, bytes[uint64_t(first_tile) * tile_size + 0],
+            bytes[uint64_t(first_tile) * tile_size + 1],
+            bytes[uint64_t(first_tile) * tile_size + 2],
+            bytes[uint64_t(first_tile) * tile_size + 3],
+            bytes[uint64_t(first_tile) * tile_size + 4],
+            bytes[uint64_t(first_tile) * tile_size + 5],
+            bytes[uint64_t(first_tile) * tile_size + 6],
+            bytes[uint64_t(first_tile) * tile_size + 7],
+            bytes[uint64_t(first_tile) * tile_size + 8],
+            bytes[uint64_t(first_tile) * tile_size + 9],
+            bytes[uint64_t(first_tile) * tile_size + 10],
+            bytes[uint64_t(first_tile) * tile_size + 11],
+            bytes[uint64_t(first_tile) * tile_size + 12],
+            bytes[uint64_t(first_tile) * tile_size + 13],
+            bytes[uint64_t(first_tile) * tile_size + 14],
+            bytes[uint64_t(first_tile) * tile_size + 15]);
+      } else {
+        REXGPU_ERROR("[FRAMEPROBE][EDRAM] staging invalidate failed result={}", int(invalidate));
+      }
+    } else {
+      REXGPU_ERROR("[FRAMEPROBE][EDRAM] queue wait failed");
+      dfn.vkUnmapMemory(vk_device, staging_memory);
+      const uint64_t submission = command_processor_.GetCurrentSubmission();
+      command_processor_.destroy_buffers_.emplace_back(submission, staging_buffer);
+      command_processor_.destroy_memory_.emplace_back(submission, staging_memory);
+      return false;
+    }
+
+    dfn.vkUnmapMemory(vk_device, staging_memory);
+    // AwaitAllQueueOperationsCompletion closes the deferred submission so the
+    // guest resolve can continue in a fresh submission in the same frame.
+  }
+  dfn.vkDestroyBuffer(vk_device, staging_buffer, nullptr);
+  dfn.vkFreeMemory(vk_device, staging_memory, nullptr);
+  return command_processor_.BeginSubmission(true);
+#else
+  return true;
+#endif
+}
+
+}  // namespace rex::graphics::vulkan
