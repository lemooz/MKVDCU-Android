diff --git a/src/core/fiber_android.cpp b/src/core/fiber_android.cpp
new file mode 100644
index 0000000..da074d9
--- /dev/null
+++ b/src/core/fiber_android.cpp
@@ -0,0 +1,152 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2026 Tom Clay. All rights reserved.                              *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ *
+ * @modified    MKVDCU Android port
+ *
+ * Bionic does not provide the ucontext family (getcontext/makecontext/
+ * swapcontext), so Android gets a minimal AArch64 cooperative context switch.
+ * Only the callee-saved integer and FP registers plus SP need to be preserved
+ * across a function call, which is all a fiber switch requires.
+ */
+
+#include <rex/platform.h>
+
+#if REX_PLATFORM_ANDROID
+
+#include <rex/thread/fiber.h>
+
+#include <cassert>
+#include <cstdint>
+#include <cstring>
+
+namespace rex::thread {
+
+// Layout must match the assembly in rex_android_context_switch.
+struct Fiber::FiberContext {
+  uint64_t regs[12];   // x19..x28, x29 (fp), x30 (lr)
+  uint64_t sp;         // stack pointer
+  uint64_t fpregs[8];  // d8..d15
+  uint64_t pad;
+};
+
+extern "C" void rex_android_fiber_entry(void* fiber);
+
+// void rex_android_context_switch(void* from, void* to)
+extern "C" __attribute__((naked, noinline)) void rex_android_context_switch(void*, void*) {
+  __asm__ __volatile__(
+      // Save callee-saved state of the current context.
+      "stp x19, x20, [x0, #0]\n"
+      "stp x21, x22, [x0, #16]\n"
+      "stp x23, x24, [x0, #32]\n"
+      "stp x25, x26, [x0, #48]\n"
+      "stp x27, x28, [x0, #64]\n"
+      "stp x29, x30, [x0, #80]\n"
+      "mov x2, sp\n"
+      "str x2, [x0, #96]\n"
+      "stp d8,  d9,  [x0, #104]\n"
+      "stp d10, d11, [x0, #120]\n"
+      "stp d12, d13, [x0, #136]\n"
+      "stp d14, d15, [x0, #152]\n"
+      // Restore the target context.
+      "ldp x19, x20, [x1, #0]\n"
+      "ldp x21, x22, [x1, #16]\n"
+      "ldp x23, x24, [x1, #32]\n"
+      "ldp x25, x26, [x1, #48]\n"
+      "ldp x27, x28, [x1, #64]\n"
+      "ldp x29, x30, [x1, #80]\n"
+      "ldr x2, [x1, #96]\n"
+      "mov sp, x2\n"
+      "ldp d8,  d9,  [x1, #104]\n"
+      "ldp d10, d11, [x1, #120]\n"
+      "ldp d12, d13, [x1, #136]\n"
+      "ldp d14, d15, [x1, #152]\n"
+      "ret\n");
+}
+
+// Entry point for a newly created fiber: x19 holds the Fiber*, x30 was set to
+// this trampoline by Create().
+extern "C" __attribute__((naked, noinline)) void rex_android_fiber_trampoline(void) {
+  __asm__ __volatile__(
+      "mov x0, x19\n"
+      "bl rex_android_fiber_entry\n"
+      "brk #0\n");
+}
+
+thread_local Fiber* Fiber::tls_current_ = nullptr;
+
+Fiber* Fiber::ConvertCurrentThread() {
+  auto* f = new Fiber();
+  f->is_thread_fiber_ = true;
+  f->context_ = new FiberContext();
+  std::memset(f->context_, 0, sizeof(FiberContext));
+  tls_current_ = f;
+  return f;
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  auto* f = new Fiber();
+  f->entry_ = entry;
+  f->arg_ = arg;
+
+  size_t size = stack_size ? stack_size : (512u * 1024u);
+  size = (size + 15u) & ~size_t(15u);
+  f->stack_.assign(size, 0);
+
+  uintptr_t top = reinterpret_cast<uintptr_t>(f->stack_.data() + size) & ~uintptr_t(15u);
+
+  f->context_ = new FiberContext();
+  std::memset(f->context_, 0, sizeof(FiberContext));
+  f->context_->regs[0] = reinterpret_cast<uint64_t>(f);  // x19
+  f->context_->regs[11] =
+      reinterpret_cast<uint64_t>(&rex_android_fiber_trampoline);  // x30
+  f->context_->sp = top;
+  return f;
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  Fiber* from = tls_current_;
+  if (!from || !target || from == target) {
+    return;
+  }
+  target->return_to_ = from;
+  tls_current_ = target;
+  rex_android_context_switch(from->context_, target->context_);
+}
+
+void Fiber::AndroidEntry(void* fiber) {
+  Fiber* f = static_cast<Fiber*>(fiber);
+  tls_current_ = f;
+  f->entry_(f->arg_);
+  // A game fiber function must switch away before returning (the XAPI wrapper
+  // does). If one returns anyway, hand control back to whoever last switched
+  // in, then park permanently on a self-switch-free block.
+  if (f->return_to_) {
+    SwitchTo(f->return_to_);
+  }
+  for (;;) {
+    // Nothing left to run; sleep instead of spinning.
+    __asm__ __volatile__("wfe");
+  }
+}
+
+void Fiber::Destroy() {
+  assert(this != tls_current_ && "Destroy called on the currently running fiber");
+  delete context_;
+  context_ = nullptr;
+  delete this;
+}
+
+}  // namespace rex::thread
+
+// The naked trampoline has no frame to pass arguments, so provide a C entry
+// that forwards the Fiber* kept in x19 to the C++ static member.
+extern "C" void rex_android_fiber_entry(void* fiber) {
+  rex::thread::Fiber::AndroidEntry(fiber);
+}
+
+#endif  // REX_PLATFORM_ANDROID
