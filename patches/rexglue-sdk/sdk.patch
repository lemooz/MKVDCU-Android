+  if (!AwaitAllQueueOperationsCompletion(rex::diagnostics::PerformanceStage::WaitDiagnostic)) {
+    destroy_buffers_.emplace_back(submission, staging);
+    destroy_memory_.emplace_back(submission, memory);
