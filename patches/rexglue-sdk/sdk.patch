+  constexpr std::string_view kDebugEulaStagePixelShaderSource = R"(#version 450
+layout(location = 0) in vec4 eula_texcoord;
+layout(location = 1) in vec4 eula_vertex_color;
+layout(location = 0) out vec4 oC0;
+layout(set = 1, binding = 0, std140) uniform XeSystemConstants {
+  layout(offset = 304) vec4 color_exp_bias;
+} xe_system_constants;
+layout(set = 1, binding = 2, std140) uniform XeFloatPixelConstants {
+  vec4 float_constants[256];
+} xe_float_pixel_constants;
+layout(set = 1, binding = 4, std140) uniform XeFetchConstants {
+  uvec4 fetch_constants[48];
+} xe_fetch_constants;
+// ReXGlue binds guest 1D/2D textures as 2D arrays, matching the translated
+// Xenos shader interface. Keep this diagnostic shader's descriptor type
+// identical even in stages where the texture sample is optimized away.
+layout(set = 3, binding = 0) uniform texture2DArray xe_texture0;
+layout(set = 3, binding = 2) uniform sampler xe_sampler0;
+void main() {
+  int stage = 0;
+  vec4 result = eula_vertex_color;
+  if (stage >= 2) {
+    float mask = texture(sampler2DArray(xe_texture0, xe_sampler0),
+                         vec3(eula_texcoord.xy, 0.0)).a;
+    // Xenos applies the signed six-bit texture exponent from TF0 word 3 to
+    // every fetched component before the shader consumes the result.
+    int texture_exp = bitfieldExtract(int(xe_fetch_constants.fetch_constants[0].w), 13, 6);
+    mask *= exp2(float(texture_exp));
+    vec4 c0 = xe_float_pixel_constants.float_constants[0];
+    vec4 c1 = xe_float_pixel_constants.float_constants[1];
+    vec4 c2 = xe_float_pixel_constants.float_constants[2];
+    vec4 c3 = xe_float_pixel_constants.float_constants[3];
+    result.rgb = (eula_vertex_color.rgb * c0.rgb + c1.rgb) * c2.x + c3.rgb;
+    result.a = eula_vertex_color.a * c0.a * mask + c1.a;
+    if (stage >= 3) result *= xe_system_constants.color_exp_bias.x;
+  }
+  // Keep alpha at one in the raw-interpolator stage so blending cannot hide
+  // the vertex RGB being measured.
+  if (stage == 1) result.a = 1.0;
+  oC0 = result;
