--- /dev/null
+++ b/src/ui/vulkan/android_native_sync.cpp
@@ -0,0 +1,210 @@
+// Android native-buffer synchronization adapter for ICDs without SYNC_FD.
+// HAL ABI fields follow AOSP hardware.h (Apache-2.0, Android Open Source Project)
+// and frameworks/native/vulkan/include/hardware/hwvulkan.h. No vendor layout
+// or GPU feature is fabricated. All rendering remains in the selected ICD.
+#include "android_native_sync.h"
+#include <rex/ui/vulkan/device.h>
+#include <rex/logging.h>
+#include <rex/diagnostics/performance.h>
+#include <atomic>
+#include <cstddef>
+#include <cstring>
+#include <cerrno>
+#include <poll.h>
+#include <unistd.h>
+#include <vector>
+
+namespace rex::ui::vulkan {
+namespace {
+struct HalModule;
+struct HalDevice {
+  uint32_t tag, version;
+  HalModule* module;
+  uint64_t reserved[12];
+  int (*close)(HalDevice*);
+};
+struct HalMethods { int (*open)(const HalModule*, const char*, HalDevice**); };
+struct HalModule {
+  uint32_t tag;
+  uint16_t module_api_version, hal_api_version;
+  const char *id, *name, *author;
+  HalMethods* methods;
+  void* dso;
+  uint64_t reserved[25];
+};
+struct VulkanHalDevice {
+  HalDevice common;
+  PFN_vkEnumerateInstanceExtensionProperties enumerate;
+  PFN_vkCreateInstance create;
+  PFN_vkGetInstanceProcAddr get_proc;
+};
+static_assert(sizeof(HalModule) == 248 && offsetof(HalModule, methods) == 32);
+static_assert(sizeof(HalDevice) == 120 && offsetof(VulkanHalDevice, get_proc) == 136);
+using AcquireImage = VkResult (*)(VkDevice, VkImage, int, VkSemaphore, VkFence);
+using ReleaseImage = VkResult (*)(VkQueue, uint32_t, const VkSemaphore*, VkImage, int*);
+HalModule* original_module;
+VulkanHalDevice* original_hal_device;
+HalModule proxy_module;
+VulkanHalDevice proxy_device;
+std::atomic<PFN_vkGetDeviceProcAddr> original_device_proc{nullptr};
+std::atomic<const VulkanDevice*> registered_device{nullptr};
+std::atomic<bool> cpu_sync{false};
+// Only the synchronous HAL callback within our prepared vkQueuePresentKHR may
+// return a completed native fence without submitting a second semaphore wait.
+thread_local VkQueue completed_present_queue = VK_NULL_HANDLE;
+
+VkResult CompletePresentationWaits(const VulkanDevice& context, uint32_t family,
+                                  uint32_t index, uint32_t count,
+                                  const VkSemaphore* waits) {
+  const auto& f = context.functions();
+  VkFenceCreateInfo fence_info{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+  VkFence fence = VK_NULL_HANDLE;
+  VkResult result = f.vkCreateFence(context.device(), &fence_info, nullptr, &fence);
+  if (result != VK_SUCCESS) return result;
+  std::vector<VkPipelineStageFlags> stages(count, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT);
+  VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+  submit.waitSemaphoreCount = count;
+  submit.pWaitSemaphores = waits;
+  submit.pWaitDstStageMask = stages.data();
+  {
+    const auto acquisition = context.AcquireQueue(family, index);
+    result = f.vkQueueSubmit(acquisition.queue(), 1, &submit, fence);
+  }
+  const bool submitted = result == VK_SUCCESS;
+  if (result == VK_SUCCESS) {
+    rex::diagnostics::PerformanceScope timing(
+        rex::diagnostics::PerformanceStage::PresentNativeFenceCpu);
+    result = f.vkWaitForFences(context.device(), 1, &fence, VK_TRUE, 5000000000ULL);
+  }
+  // A failed submit has no pending fence. A timed-out or otherwise failed wait
+  // may still have one; retain it until device teardown in those cases.
+  if (!submitted || result == VK_SUCCESS || result == VK_ERROR_DEVICE_LOST)
+    f.vkDestroyFence(context.device(), fence, nullptr);
+  return result == VK_TIMEOUT ? VK_ERROR_DEVICE_LOST : result;
+}
+
+// Consume the native acquire fence even on failure, as required by Android.
+bool ConsumeNativeFence(int fd) {
+  if (fd < 0) return true;
+  pollfd descriptor{fd, POLLIN, 0};
+  int result;
+  do { result = poll(&descriptor, 1, 5000); } while (result < 0 && errno == EINTR);
+  const bool signaled = result > 0 && (descriptor.revents & POLLIN) &&
+      !(descriptor.revents & (POLLERR | POLLNVAL));
+  close(fd);
+  return signaled;
+}
+VkResult Acquire(VkDevice device, VkImage image, int fd, VkSemaphore semaphore, VkFence fence) {
+  const auto* context = registered_device.load(std::memory_order_acquire);
+  auto get_proc = original_device_proc.load(std::memory_order_acquire);
+  if (!cpu_sync.load(std::memory_order_relaxed)) {
+    auto original = get_proc ? reinterpret_cast<AcquireImage>(get_proc(device, "vkAcquireImageANDROID")) : nullptr;
+    if (original) return original(device, image, fd, semaphore, fence);
+    if (fd >= 0) close(fd);
+    return VK_ERROR_INITIALIZATION_FAILED;
+  }
+  if (!ConsumeNativeFence(fd)) return VK_ERROR_DEVICE_LOST;
+  if (!context || context->device() != device) return VK_ERROR_INITIALIZATION_FAILED;
+  if (semaphore == VK_NULL_HANDLE && fence == VK_NULL_HANDLE) return VK_SUCCESS;
+  // The same recursive queue lock is used by the renderer and Presenter.
+  // An empty submit signals the real Vulkan semaphore/fence after the native
+  // acquire fence completed. Host-signaling a binary semaphore is not valid.
+  auto queue = context->AcquireQueue(context->queue_family_graphics_compute(), 0);
+  VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+  submit.signalSemaphoreCount = semaphore != VK_NULL_HANDLE ? 1 : 0;
+  submit.pSignalSemaphores = &semaphore;
+  return context->functions().vkQueueSubmit(queue.queue(), 1, &submit, fence);
+}
+VkResult Release(VkQueue queue, uint32_t count, const VkSemaphore* waits, VkImage image, int* fd) {
+  const auto* context = registered_device.load(std::memory_order_acquire);
+  auto get_proc = original_device_proc.load(std::memory_order_acquire);
+  if (!context || !fd) return VK_ERROR_INITIALIZATION_FAILED;
+  if (!cpu_sync.load(std::memory_order_relaxed)) {
+    auto original = get_proc ? reinterpret_cast<ReleaseImage>(get_proc(context->device(), "vkQueueSignalReleaseImageANDROID")) : nullptr;
+    return original ? original(queue, count, waits, image, fd) : VK_ERROR_INITIALIZATION_FAILED;
+  }
+  // Returning -1 denotes completed work, not a fabricated sync-file. Consume
+  // every present semaphore with a real queue submit, and wait for its fence
+  // before permitting SurfaceFlinger to use the buffer.
+  *fd = -1;
+  if (!count && completed_present_queue == queue) return VK_SUCCESS;
+  const auto& families = context->queue_families();
+  for (uint32_t family = 0; family < families.size(); ++family) {
+    for (uint32_t index = 0; index < families[family].queues.size(); ++index) {
+      if (families[family].queues[index]->queue != queue) continue;
+      // Unprepared external callers retain the conservative fallback. Never
+      // unlock a mutex owned by the caller while vkQueuePresentKHR is active:
+      // Vulkan requires external synchronization for that entire queue call.
+      return CompletePresentationWaits(*context, family, index, count, waits);
+    }
+  }
+  return VK_ERROR_INITIALIZATION_FAILED;
+}
+PFN_vkVoidFunction DeviceProc(VkDevice device, const char* name) {
+  if (!std::strcmp(name, "vkAcquireImageANDROID")) return reinterpret_cast<PFN_vkVoidFunction>(&Acquire);
+  if (!std::strcmp(name, "vkQueueSignalReleaseImageANDROID")) return reinterpret_cast<PFN_vkVoidFunction>(&Release);
+  auto original = original_device_proc.load(std::memory_order_acquire);
+  return original ? original(device, name) : nullptr;
+}
+PFN_vkVoidFunction InstanceProc(VkInstance instance, const char* name) {
+  auto result = original_hal_device->get_proc(instance, name);
+  if (!std::strcmp(name, "vkGetDeviceProcAddr") && result) {
+    original_device_proc.store(reinterpret_cast<PFN_vkGetDeviceProcAddr>(result), std::memory_order_release);
+    return reinterpret_cast<PFN_vkVoidFunction>(&DeviceProc);
+  }
+  return result;
+}
+int Close(HalDevice*) { return original_hal_device->common.close(&original_hal_device->common); }
+int Open(const HalModule*, const char* id, HalDevice** out) {
+  HalDevice* opened = nullptr;
+  int result = original_module->methods->open(original_module, id, &opened);
+  if (result || !opened) return result ? result : -EINVAL;
+  original_hal_device = reinterpret_cast<VulkanHalDevice*>(opened);
+  proxy_device = *original_hal_device;
+  proxy_device.common.close = &Close;
+  proxy_device.get_proc = &InstanceProc;
+  *out = &proxy_device.common;
+  return 0;
+}
+HalMethods proxy_methods{&Open};
+}
+void* PanvkNativeSyncHal(void* module) {
+  original_module = static_cast<HalModule*>(module);
+  if (!original_module || !original_module->id || std::strcmp(original_module->id, "vulkan") ||
+      !original_module->methods || !original_module->methods->open) return nullptr;
+  proxy_module = *original_module;
+  proxy_module.methods = &proxy_methods;
+  return &proxy_module;
+}
+void PanvkNativeSyncConfigure(bool enabled) { cpu_sync.store(enabled, std::memory_order_relaxed); }
+bool PanvkNativeSyncEnabled() { return cpu_sync.load(std::memory_order_relaxed); }
+VkResult PanvkNativeSyncQueuePresent(const VulkanDevice& device, uint32_t family,
+                                    uint32_t index, const VkPresentInfoKHR& info) {
+  VkPresentInfoKHR prepared = info;
+  const bool prepare = PanvkNativeSyncEnabled();
+  if (prepare) {
+    const VkResult result = CompletePresentationWaits(
+        device, family, index, info.waitSemaphoreCount, info.pWaitSemaphores);
+    if (result != VK_SUCCESS) return result;
+    // Each binary semaphore has already been consumed exactly once. Its signal
+    // and every preceding swapchain write completed before the CPU fence fired.
+    prepared.waitSemaphoreCount = 0;
+    prepared.pWaitSemaphores = nullptr;
+  }
+  const auto acquisition = [&] {
+    rex::diagnostics::PerformanceScope acquire(rex::diagnostics::PerformanceStage::PresentQueueAcquireCpu);
+    return device.AcquireQueue(family, index);
+  }();
+  rex::diagnostics::PerformanceScope call(rex::diagnostics::PerformanceStage::PresentCallCpu);
+  const VkQueue previous = completed_present_queue;
+  if (prepare) completed_present_queue = acquisition.queue();
+  const VkResult result = device.functions().vkQueuePresentKHR(acquisition.queue(), &prepared);
+  completed_present_queue = previous;
+  return result;
+}
+void PanvkNativeSyncRegister(const VulkanDevice* device) { registered_device.store(device, std::memory_order_release); }
+void PanvkNativeSyncUnregister(const VulkanDevice* device) {
+  const VulkanDevice* expected = device;
+  registered_device.compare_exchange_strong(expected, nullptr, std::memory_order_acq_rel);
+}
+}
