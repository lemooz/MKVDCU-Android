@@ -0,0 +1,34 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2021 Ben Vanik. All rights reserved.                             *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ *
+ * @modified    MKVDCU Android port
+ */
+
+#include <rex/ui/surface_android.h>
+
+#include <android/native_window.h>
+
+namespace rex {
+namespace ui {
+
+bool AndroidNativeWindowSurface::GetSizeImpl(uint32_t& width_out, uint32_t& height_out) const {
+  if (!window_) {
+    return false;
+  }
+  const int32_t width = ANativeWindow_getWidth(window_);
+  const int32_t height = ANativeWindow_getHeight(window_);
+  if (width <= 0 || height <= 0) {
+    return false;
+  }
+  width_out = uint32_t(width);
+  height_out = uint32_t(height);
+  return true;
+}
+
+}  // namespace ui
+}  // namespace rex
diff --git a/src/ui/vulkan/android_driver.cpp b/src/ui/vulkan/android_driver.cpp
new file mode 100644
index 0000000..4c406e8
--- /dev/null
+++ b/src/ui/vulkan/android_driver.cpp
@@ -0,0 +1,514 @@
+#include <rex/ui/vulkan/android_driver.h>
+#include <rex/ui/vulkan/instance.h>
+#include <rex/ui/vulkan/device.h>
+#include <rex/logging.h>
+#include <rex/diagnostics/performance.h>
+#include <rex/diagnostics/health.h>
+#include <adrenotools/driver.h>
+#include <android_linker_ns.h>
+#include <android/native_window_jni.h>
+#include <jni.h>
+#include <dlfcn.h>
+#include <mutex>
+#include <filesystem>
+#include <fstream>
+#include <sstream>
+#include <iomanip>
+#include <cstring>
+#include <stdexcept>
+#include <cstdlib>
+#include <vector>
+#include <unistd.h>
+#include <sched.h>
+#include <algorithm>
+#include <cerrno>
+#include "android_driver_smoke.h"
+#include "android_native_sync.h"
+#include "../android_driver/panvk_loader_hook.h"
+
+namespace rex::ui::vulkan {
+namespace {
+std::mutex mutex;
+std::string kind = "system", directory, library, hooks, temporary, package_id;
+std::string identity = "Vulkan ainda não inicializado", error;
+std::string reported_driver;
+std::string mesa_cache;
+std::vector<std::string> dependencies;
+std::vector<void*> dependency_handles;
+android_namespace_t* panvk_namespace = nullptr;  // Retained with the ICD.
+android_namespace_t* panvk_loader_namespace = nullptr;
+void* panvk_hal = nullptr;
+void* handle = nullptr;  // Retained until process exit, including driver workers.
+PFN_vkGetInstanceProcAddr proc_addr = nullptr;
+bool frozen = false;
+bool loaded_direct_icd = false;
+bool disable_lossy_afrc = false;
+int turnip_mode = 0;
+bool panvk_late_stencil = false;
+std::string JString(JNIEnv* env, jstring s) {
+  if (!s) return {};
+  const char* chars = env->GetStringUTFChars(s, nullptr);
+  std::string result(chars ? chars : "");
+  if (chars) env->ReleaseStringUTFChars(s, chars);
+  return result;
+}
+}  // namespace
+
+PFN_vkGetInstanceProcAddr AndroidDriverProcAddr(bool& direct_icd) {
+  std::lock_guard lock(mutex);
+  direct_icd = kind == "panvk";
+  if (frozen) { direct_icd = loaded_direct_icd; return proc_addr; }
+  frozen = true;
+  if (kind == "panvk") {
+    if (setenv("PANVK_STENCIL_LATE", panvk_late_stencil ? "1" : "0", 1) ||
+        setenv("PANVK_TRACE", "0", 1)) {
+      error = "Falha ao configurar opções PanVK";
+      return nullptr;
+    }
+    REXLOG_INFO("[DRIVER] PanVK late_stencil={} trace=off heaps=driver-default", panvk_late_stencil);
+  }
+  if (kind == "turnip") {
+    // Driver options are fixed before any Mesa constructor or Vulkan instance.
+    // Never enable flushall/syncdraw: those serialize each draw. Auto leaves
+    // Turnip's own choice intact; forced modes are explicit comparison options.
+    const char* option = turnip_mode == 1 ? "sysmem" : turnip_mode == 2 ? "gmem" : "";
+    if (setenv("TU_DEBUG", option, 1) || unsetenv("TU_DEBUG_FILE")) {
+      error = "Falha ao configurar o modo Turnip";
+      return nullptr;
+    }
+    REXLOG_INFO("[DRIVER] Turnip render mode={} TU_DEBUG='{}'", turnip_mode, option);
+  }
+  // Mesa reads options at library initialization. Keep cache / precision
+  // configuration local to this dedicated process and set it before dlopen.
+  if (kind == "panvk" || kind == "turnip") {
+    if (setenv("MESA_SHADER_CACHE_DIR", mesa_cache.c_str(), 1) ||
+        setenv("MESA_SHADER_CACHE_DISABLE", "false", 1) ||
+        setenv("MESA_SHADER_CACHE_MAX_SIZE", "256M", 1) ||
+        // FristOneRR defaults this to 1 in an ELF constructor, advertising
+        // geometry/multiViewport/BC for DXVK feature-level negotiation. This
+        // app uses Vulkan directly: query genuine features before pipelines.
+        (kind == "panvk" && setenv("PANVK_DXVK_COMPAT", "0", 1)) ||
+        (disable_lossy_afrc && setenv("PANVK_BC_AFRC", "0", 1))) {
+      error = "Falha ao configurar cache / precisão do driver Mesa";
+      return nullptr;
+    }
+    REXLOG_INFO("[DRIVER] Mesa cache requested={} limit=256M PanVK lossy AFRC={}",
+                mesa_cache, disable_lossy_afrc ? "off (CSF profile)" : "driver default");
+    if (kind == "panvk") REXLOG_INFO("[DRIVER] Native Vulkan: PANVK_DXVK_COMPAT=0 (no DXVK feature spoofing)");
+  }
+  if (kind == "system") {
+    handle = dlopen("libvulkan.so", RTLD_NOW | RTLD_LOCAL);
+  } else if (kind == "turnip" || kind == "adreno") {
+    // Pinned libadrenotools concatenates customDriverDir + customDriverName
+    // for stat(), without inserting '/'. A Java absolute directory has no
+    // trailing separator; passing it verbatim rejected every valid package.
+    const std::string driver_directory = directory + (directory.ends_with('/') ? "" : "/");
+    const std::string temporary_directory = temporary + (temporary.ends_with('/') ? "" : "/");
+    handle = adrenotools_open_libvulkan(RTLD_NOW | RTLD_LOCAL, ADRENOTOOLS_DRIVER_CUSTOM,
+        temporary_directory.c_str(), hooks.c_str(), driver_directory.c_str(), library.c_str(), nullptr, nullptr);
+  } else if (kind == "panvk") {
+    // libhardware is a real Android system dependency of Mesa's Android WSI.
+    // It is hidden from the Java classloader namespace. Use a separate ICD
+    // namespace, via the already pinned linker support library; no Qualcomm
+    // hooks, KGSL, replacement HAL or Winlator wrapper are involved here.
+    if (!linkernsbypass_load_status()) {
+      error = "Suporte de namespace Android indisponível para o ICD PanVK";
+      return nullptr;
+    }
+    panvk_namespace = android_create_namespace("mkvdcu-panvk", directory.c_str(),
+        "/system/lib64", ANDROID_NAMESPACE_TYPE_REGULAR, nullptr, nullptr);
+    if (!panvk_namespace || !linkernsbypass_link_namespace_to_default_all_libs(panvk_namespace)) {
+      error = "Não foi possível criar/vincular o namespace Android do ICD PanVK";
+      return nullptr;
+    }
+    REXLOG_INFO("[DRIVER] PanVK dedicated namespace: private package + Android system libraries");
+    // A separate copy belongs to the ICD namespace. The WSI selector below
+    // has its own state and must not redirect the system mapper to a Vulkan HAL.
+    void* mapper_vndk = linkernsbypass_namespace_dlopen("/system/lib64/libvndksupport.so",
+        RTLD_NOW | RTLD_LOCAL, panvk_namespace);
+    auto mapper_sphal = mapper_vndk ? reinterpret_cast<PanvkLoadSphal>(
+        dlsym(mapper_vndk, "android_load_sphal_library")) : nullptr;
+    if (mapper_sphal && (access("/vendor/lib64/hw/android.hardware.graphics.mapper@4.0-impl.so", F_OK) == 0 ||
+        access("/odm/lib64/hw/android.hardware.graphics.mapper@4.0-impl.so", F_OK) == 0)) {
+      void* mapper_bridge = linkernsbypass_namespace_dlopen_unique(
+          (std::filesystem::path(hooks) / "libpanvk_mapper_hook.so").c_str(), nullptr,
+          RTLD_NOW | RTLD_GLOBAL, panvk_namespace);
+      auto initialize_mapper = mapper_bridge ? reinterpret_cast<PanvkInitializeMapperHook>(
+          dlsym(mapper_bridge, "mkvdcu_panvk_initialize_mapper_hook")) : nullptr;
+      if (!initialize_mapper || setenv("PANVK_MAPPER_NAMES", "default", 1)) {
+        error = "Falha ao preparar mapper HIDL padrão no namespace PanVK";
+        return nullptr;
+      }
+      initialize_mapper(mapper_bridge, &android_dlopen_ext, mapper_sphal, &access);
+      dependency_handles.push_back(mapper_bridge);
+      dependency_handles.push_back(mapper_vndk);
+      REXLOG_INFO("[DRIVER] PanVK default HIDL mapper bridge enabled; native vendor metadata required");
+    } else if (mapper_vndk) {
+      dependency_handles.push_back(mapper_vndk);
+    }
+    // Android does not add the dlopened library's directory to DT_NEEDED
+    // searches. Java verified ARM64/Bionic, names and the dependency DAG.
+    // Load only that DAG by absolute path, not every .so in an archive.
+    for (const auto& dependency : dependencies) {
+      const auto path = std::filesystem::path(directory) / dependency;
+      void* dependency_handle = linkernsbypass_namespace_dlopen(
+          path.c_str(), RTLD_NOW | RTLD_LOCAL, panvk_namespace);
+      if (!dependency_handle) {
+        const char* detail = dlerror();
+        error = "Dependência PanVK " + dependency + ": " + (detail ? detail : "dlopen falhou");
+        REXLOG_ERROR("[DRIVER] {}", error);
+        return nullptr;
+      }
+      dependency_handles.push_back(dependency_handle);  // Retained until process exit.
+    }
+    handle = linkernsbypass_namespace_dlopen((std::filesystem::path(directory) / library).c_str(),
+        RTLD_NOW | RTLD_LOCAL, panvk_namespace);
+    if (handle && dlsym(handle, "HMI")) {
+      // Android HAL ICDs expose VK_ANDROID_native_buffer, not necessarily
+      // VK_KHR_android_surface. Let a fresh Android loader provide WSI and
+      // dispatch all device calls to this same selected HMI module.
+      panvk_hal = handle;
+      panvk_loader_namespace = android_create_namespace("mkvdcu-panvk-wsi", hooks.c_str(),
+          "/system/lib64", ANDROID_NAMESPACE_TYPE_REGULAR, nullptr, nullptr);
+      if (!panvk_loader_namespace ||
+          !linkernsbypass_link_namespace_to_default_all_libs(panvk_loader_namespace)) {
+        error = "Não foi possível criar o namespace do loader Android/PanVK";
+        return nullptr;
+      }
+      void* bridge = linkernsbypass_namespace_dlopen("libpanvk_loader_hook.so",
+          RTLD_NOW | RTLD_GLOBAL, panvk_loader_namespace);
+      auto initialize = bridge ? reinterpret_cast<PanvkInitializeLoaderHook>(
+          dlsym(bridge, "mkvdcu_panvk_initialize_loader_hook")) : nullptr;
+      if (!initialize) {
+        const char* detail = dlerror();
+        error = std::string("Ponte Android/PanVK ausente: ") + (detail ? detail : "entrypoint inválido");
+        return nullptr;
+      }
+      dependency_handles.push_back(bridge);
+      void* vndk = linkernsbypass_namespace_dlopen("/system/lib64/libvndksupport.so",
+          RTLD_NOW | RTLD_LOCAL, panvk_namespace);
+      auto sphal = vndk ? reinterpret_cast<PanvkLoadSphal>(dlsym(vndk,"android_load_sphal_library")) : nullptr;
+      if (vndk) dependency_handles.push_back(vndk);
+      auto set_module = reinterpret_cast<void (*)(const void*)>(dlsym(bridge, "mkvdcu_panvk_set_hal_module"));
+      void* module = PanvkNativeSyncHal(dlsym(panvk_hal, "HMI"));
+      if (!set_module || !module) {
+        error = "HAL PanVK incompatível com a ponte Android native-buffer";
+        return nullptr;
+      }
+      set_module(module);
+      initialize(bridge, &android_dlopen_ext, sphal);
+      handle = linkernsbypass_namespace_dlopen_unique("/system/lib64/libvulkan.so",
+          nullptr, RTLD_NOW | RTLD_LOCAL, panvk_loader_namespace);
+      direct_icd = false;
+      REXLOG_INFO("[DRIVER] PanVK HMI selected through fresh Android Vulkan loader/WSI");
+    }
+  }
+  if (!handle) {
+    const char* e = dlerror();
+    error = std::string("Falha ao carregar driver: ") + (e ? e : "loader recusou pacote");
+    if (kind == "panvk" && e && std::strstr(e, "libhardware.so"))
+      error += ". libhardware.so não pôde ser resolvida no namespace do ICD; o build Android/WSI deste pacote é incompatível com este sistema";
+    REXLOG_ERROR("[DRIVER] {}", error);
+    return nullptr;
+  }
+  proc_addr = reinterpret_cast<PFN_vkGetInstanceProcAddr>(
+      dlsym(handle, direct_icd ? "vk_icdGetInstanceProcAddr" : "vkGetInstanceProcAddr"));
+  if (direct_icd && !proc_addr)
+    proc_addr = reinterpret_cast<PFN_vkGetInstanceProcAddr>(dlsym(handle, "vkGetInstanceProcAddr"));
+  if (!proc_addr) error = "Driver sem entrypoint Vulkan utilizável";
+  loaded_direct_icd = direct_icd;
+  identity = kind + (package_id.empty() ? "" : "/" + package_id.substr(0, 12));
+  REXLOG_INFO("[DRIVER] loader={} direct_icd={} proc={}", identity, direct_icd, bool(proc_addr));
+  return proc_addr;
+}
+
+std::string AndroidDriverIdentity() {
+  std::lock_guard lock(mutex);
+  return identity;
+}
+std::string AndroidDriverError() {
+  std::lock_guard lock(mutex);
+  return error;
+}
+std::string AndroidDriverCacheKey(const VkPhysicalDeviceProperties& p) {
+  std::lock_guard lock(mutex);
+  std::ostringstream out;
+  out << kind << '-' << package_id << '-' << std::hex << p.vendorID << '-' << p.deviceID
+      << '-' << p.driverVersion << '-';
+  for (auto b : p.pipelineCacheUUID) out << std::setw(2) << std::setfill('0') << unsigned(b);
+  out << "-renderer-20261013-loader5";
+  if (kind == "turnip" || kind == "adreno") out << "-adreno6-tumode" << turnip_mode;
+  if (kind == "panvk" && panvk_late_stencil) out << "-late-stencil1";
+  return out.str();
+}
+void AndroidDriverRecordDevice(const VkPhysicalDeviceProperties& p) {
+  std::lock_guard lock(mutex);
+  identity = p.deviceName + std::string(" / ") + reported_driver + " / " + std::to_string(p.driverVersion) +
+      " / " + kind + (kind == "system" ? "" : "/" + package_id.substr(0, 12));
+  if (kind == "panvk" && PanvkNativeSyncEnabled()) identity += " / native-fence CPU";
+  if (kind == "panvk" && panvk_late_stencil) identity += " / late stencil";
+  if (kind == "turnip") identity += turnip_mode == 1 ? " / Sysmem" : turnip_mode == 2 ? " / GMEM" : " / Auto";
+  REXLOG_INFO("[DRIVER] actual={} vendor=0x{:X} device=0x{:X}", identity, p.vendorID, p.deviceID);
+}
+bool AndroidDriverCheckDevice(const VulkanInstance& instance, VkPhysicalDevice physical) {
+  const auto& f = instance.functions();
+  VkPhysicalDeviceProperties properties;
+  f.vkGetPhysicalDeviceProperties(physical, &properties);
+  bool driver_properties = properties.apiVersion >= VK_API_VERSION_1_2;
+  uint32_t count = 0;
+  if (f.vkEnumerateDeviceExtensionProperties(physical, nullptr, &count, nullptr) == VK_SUCCESS) {
+    std::vector<VkExtensionProperties> extensions(count);
+    if (f.vkEnumerateDeviceExtensionProperties(physical, nullptr, &count, extensions.data()) == VK_SUCCESS)
+      for (const auto& extension : extensions)
+        if (!std::strcmp(extension.extensionName, VK_KHR_DRIVER_PROPERTIES_EXTENSION_NAME)) driver_properties = true;
+  }
+  VkPhysicalDeviceDriverProperties driver{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRIVER_PROPERTIES};
+  if (driver_properties && f.vkGetPhysicalDeviceProperties2) {
+    VkPhysicalDeviceProperties2 properties2{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2};
+    properties2.pNext = &driver;
+    f.vkGetPhysicalDeviceProperties2(physical, &properties2);
+  }
+  std::lock_guard lock(mutex);
+  reported_driver = driver.driverName[0] ? driver.driverName : "identidade não anunciada";
+  // AdrenoTools can silently fall back to the OEM driver when a hook fails.
+  // A successful dlopen is not proof that the requested Turnip is running.
+  if (kind == "turnip" && (properties.vendorID != 0x5143 || driver.driverID != VK_DRIVER_ID_MESA_TURNIP)) {
+    error = "Turnip não está ativo nesta GPU; possível fallback do loader";
+    REXLOG_ERROR("[DRIVER] {} actual={}", error, reported_driver);
+    return false;
+  }
+  if (kind == "adreno" && properties.vendorID != 0x5143) {
+    error = "Pacote Adreno requer uma GPU Qualcomm";
+    return false;
+  }
+  if (kind == "panvk" && (properties.vendorID != 0x13B5 ||
+      (driver_properties && driver.driverID != VK_DRIVER_ID_MESA_PANVK))) {
+    error = "PanVK não está ativo na GPU ARM Mali";
+    REXLOG_ERROR("[DRIVER] PanVK não enumerou GPU ARM Mali");
+    return false;
+  }
+  if (kind == "panvk") {
+    auto external = reinterpret_cast<PFN_vkGetPhysicalDeviceExternalSemaphoreProperties>(
+        proc_addr(instance.instance(), "vkGetPhysicalDeviceExternalSemaphoreProperties"));
+    if (!external) external = reinterpret_cast<PFN_vkGetPhysicalDeviceExternalSemaphoreProperties>(
+        proc_addr(instance.instance(), "vkGetPhysicalDeviceExternalSemaphorePropertiesKHR"));
+    VkPhysicalDeviceExternalSemaphoreInfo info{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_SEMAPHORE_INFO};
+    info.handleType = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_SYNC_FD_BIT;
+    VkExternalSemaphoreProperties support{VK_STRUCTURE_TYPE_EXTERNAL_SEMAPHORE_PROPERTIES};
+    if (external) external(physical, &info, &support);
+    constexpr auto required = VK_EXTERNAL_SEMAPHORE_FEATURE_IMPORTABLE_BIT | VK_EXTERNAL_SEMAPHORE_FEATURE_EXPORTABLE_BIT;
+    const bool missing_sync_fd = (support.externalSemaphoreFeatures & required) != required;
+    PanvkNativeSyncConfigure(missing_sync_fd);
+    REXLOG_INFO("[DRIVER] PanVK SYNC_FD features=0x{:X} Android native-fence bridge={}",
+        support.externalSemaphoreFeatures, missing_sync_fd ? "CPU completion" : "native ICD");
+  }
+  return true;
+}
+
+bool AndroidDriverCheckDispatch(PFN_vkVoidFunction draw) {
+  std::lock_guard lock(mutex);
+  Dl_info origin{};
+  const bool identified = draw && dladdr(reinterpret_cast<const void*>(draw), &origin) && origin.dli_fname;
+  REXLOG_INFO("[DRIVER] vkCmdDraw dispatch={}", identified ? origin.dli_fname : "unavailable");
+  // Confirm the selected ELF too: a system Mesa driver may also report Turnip.
+  // Merely seeing the right driverID is not proof that this package was loaded.
+  bool selected_mapped = false;
+  if (kind == "adreno" || kind == "turnip") {
+    const auto selected = (std::filesystem::path(directory) / library).string();
+    std::error_code selected_error;
+    const auto selected_path = std::filesystem::weakly_canonical(selected, selected_error);
+    std::ifstream maps("/proc/self/maps");
+    std::string line;
+    while (std::getline(maps, line)) {
+      const auto path = line.find('/');
+      if (path != std::string::npos && !selected_error) {
+        std::error_code mapped_error;
+        const auto mapped = std::filesystem::weakly_canonical(line.substr(path), mapped_error);
+        if (!mapped_error && mapped == selected_path) {
+          selected_mapped = true;
+          break;
+        }
+      }
+    }
+    if (!selected_mapped) {
+      error = "O ELF do pacote Qualcomm selecionado não está mapeado; loader usou outro driver";
+      REXLOG_ERROR("[DRIVER] {}", error);
+      return false;
+    }
+    REXLOG_INFO("[DRIVER] selected ELF mapped={} dispatch={}", selected,
+                identified ? origin.dli_fname : "opaque");
+  }
+  // Non-Turnip Qualcomm packages have no portable driver ID distinguishing
+  // them from the OEM fallback. Require the real draw entrypoint to originate
+  // in the selected ELF. Reject an opaque loader/layer trampoline rather than
+  // claiming an unproven custom driver is active.
+  if (kind == "adreno") {
+    std::error_code actual_error, expected_error;
+    const auto actual = identified ? std::filesystem::weakly_canonical(origin.dli_fname, actual_error) : std::filesystem::path{};
+    const auto expected = std::filesystem::weakly_canonical(std::filesystem::path(directory) / library, expected_error);
+    bool matches = identified && !actual_error && !expected_error && actual == expected;
+    // Some Qualcomm packages split their implementation into DT_NEEDED helpers.
+    // Accept only helpers validated by ElfDriver's reachable dependency graph,
+    // and only after confirming the selected root ELF is mapped in this process.
+    for (const auto& dependency : dependencies) {
+      std::error_code dependency_error;
+      const auto helper = std::filesystem::weakly_canonical(
+          std::filesystem::path(directory) / dependency, dependency_error);
+      if (selected_mapped && identified && !actual_error && !dependency_error && actual == helper) matches = true;
+    }
+    if (!matches) {
+      error = "Não foi possível confirmar execução do pacote Adreno selecionado (fallback ou trampoline)";
+      REXLOG_ERROR("[DRIVER] {}", error);
+      return false;
+    }
+  }
+  return true;
+}
