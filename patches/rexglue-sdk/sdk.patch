diff --git a/src/system/performance.cpp b/src/system/performance.cpp
new file mode 100644
index 0000000..98a5b83
--- /dev/null
+++ b/src/system/performance.cpp
@@ -0,0 +1,71 @@
+#define REX_HEALTH_IMPLEMENTATION
+#include <rex/diagnostics/performance.h>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <sstream>
+namespace rex::diagnostics {
+namespace {
+struct Counter { std::atomic<uint64_t> ns{0}, count{0}; };
+std::array<Counter, uint32_t(PerformanceStage::Count)> counters;
+std::atomic<bool> enabled{false};
+constexpr const char* names[] = {"draw_cpu", "shader", "pipeline", "texture", "resolve_cpu",
+  "submission_cpu", "fence_wait", "gpu_submission", "gpu_draw_sampled", "gpu_rt_dump_sampled",
+  "gpu_resolve_sampled", "gpu_texture_upload_sampled", "occlusion_readback_cpu", "submission_retirement_cpu",
+  "queue_acquire_cpu", "queue_submit_cpu", "submission_replay_cpu", "pipeline_wait_cpu",
+  "wait_frame_throttle", "wait_memexport", "wait_resolve", "wait_occlusion",
+  "wait_diagnostic", "wait_descriptor_reuse", "wait_explicit_sync",
+  "present_native_fence_cpu", "present_ready_wait_cpu", "present_queue_acquire_cpu", "present_call_cpu"};
+static_assert(sizeof(names) / sizeof(names[0]) == uint32_t(PerformanceStage::Count));
+constexpr const char* metric_names[] = {"queue_submits", "rt_pass_begins", "resolve_commands",
+  "texture_cache_hits", "texture_cache_misses", "texture_cache_creates",
+  "texture_cache_evictions", "texture_uploads_queued", "texture_upload_guest_bytes"};
+static_assert(sizeof(metric_names) / sizeof(metric_names[0]) == uint32_t(GraphicsMetric::Count));
+std::array<std::atomic<uint64_t>, uint32_t(GraphicsMetric::Count)> metrics;
+uint64_t Now() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+      std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+}
+void EnablePerformance(bool value) { enabled.store(value, std::memory_order_relaxed); }
+bool PerformanceEnabled() { return enabled.load(std::memory_order_relaxed); }
+const char* PerformanceStageName(PerformanceStage stage) {
+  return uint32_t(stage) < uint32_t(PerformanceStage::Count) ? names[uint32_t(stage)] : "unknown";
+}
+PerformanceTotals ReadPerformance(PerformanceStage stage) {
+  const auto& counter = counters[uint32_t(stage)];
+  return {counter.count.load(std::memory_order_relaxed), counter.ns.load(std::memory_order_relaxed)};
+}
+void RecordGraphicsMetric(GraphicsMetric metric, uint64_t amount) {
+  if (!enabled.load(std::memory_order_relaxed)) return;
+  metrics[uint32_t(metric)].fetch_add(amount, std::memory_order_relaxed);
+}
+uint64_t ReadGraphicsMetric(GraphicsMetric metric) {
+  return metrics[uint32_t(metric)].load(std::memory_order_relaxed);
+}
+void RecordPerformance(PerformanceStage stage, uint64_t ns) {
+  auto& counter = counters[uint32_t(stage)];
+  counter.ns.fetch_add(ns, std::memory_order_relaxed);
+  counter.count.fetch_add(1, std::memory_order_relaxed);
+}
+PerformanceScope::PerformanceScope(PerformanceStage stage) : stage_(stage) {
+  if (PerformanceEnabled()) started_ = Now();
+}
+PerformanceScope::~PerformanceScope() {
+  if (started_) RecordPerformance(stage_, Now() - started_);
+}
+std::string PerformanceSummary() {
+  std::ostringstream out;
+  // Cumulative inclusive CPU wall durations. GPU is actual timestamp duration,
+  // not GPU utilization and not time spent waiting on a fence.
+  for (uint32_t i = 0; i < uint32_t(PerformanceStage::Count); ++i) {
+    if (i) out << ' ';
+    out << names[i] << '=' << counters[i].count.load(std::memory_order_relaxed)
+        << '/' << counters[i].ns.load(std::memory_order_relaxed) / 1000000.0;
+  }
+  for (uint32_t i = 0; i < uint32_t(GraphicsMetric::Count); ++i) {
+    out << ' ' << metric_names[i] << '=' << metrics[i].load(std::memory_order_relaxed);
+  }
+  return out.str();
+}
+}  // namespace rex::diagnostics
