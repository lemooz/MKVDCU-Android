+      progress("Executando vkQueueSubmit");
+      Check(f.vkQueueSubmit(queue.queue(),1,&info,fence), "Submit"); }
+    REXLOG_INFO("[DRIVERPROBE] BEGIN fence (5s)");
+    progress("Esperando GPU fence (5s)");
+    Check(f.vkWaitForFences(vkdevice,1,&fence,VK_TRUE,5000000000ULL), "GPU fence (5s)");
+  };
+  auto clear_pass = [&](VkRenderPass pass, VkFramebuffer fb, VkExtent2D extent, VkPipeline draw, bool blend_test = false) {
+    VkClearValue clear{}; clear.color = {{0,0,0,0}};
+    if (!draw) clear.color = {{0.25f,0.5f,0.75f,1}};
+    VkRenderPassBeginInfo info{VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO};
+    info.renderPass = pass; info.framebuffer = fb; info.renderArea.extent = extent;
+    info.clearValueCount = 1; info.pClearValues = &clear;
+    f.vkCmdBeginRenderPass(command,&info,VK_SUBPASS_CONTENTS_INLINE);
+    if (draw) {
+      const float base_color[] = {0.25f,0.5f,0.75f,1.0f};
+      f.vkCmdPushConstants(command,graphics_layout,VK_SHADER_STAGE_FRAGMENT_BIT,0,16,base_color);
+      f.vkCmdBindPipeline(command,VK_PIPELINE_BIND_POINT_GRAPHICS,draw);
+      f.vkCmdDraw(command,3,1,0,0);
+      if (blend_test) {
+        const float source[] = {0.75f,0.25f,0.5f,0.5f};
+        f.vkCmdPushConstants(command,graphics_layout,VK_SHADER_STAGE_FRAGMENT_BIT,0,16,source);
+        f.vkCmdBindPipeline(command,VK_PIPELINE_BIND_POINT_GRAPHICS,blend_pipeline);
+        f.vkCmdDraw(command,3,1,0,0);
+      }
+    }
+    f.vkCmdEndRenderPass(command);
+  };
+  REXLOG_INFO("[DRIVERPROBE] BEGIN first compute/readback");
+  begin();
+  f.vkCmdBindPipeline(command,VK_PIPELINE_BIND_POINT_COMPUTE,compute_pipeline);
+  f.vkCmdBindDescriptorSets(command,VK_PIPELINE_BIND_POINT_COMPUTE,compute_layout,0,1,&descriptor_set,0,nullptr);
+  f.vkCmdDispatch(command,1,1,1);
+  VkBufferMemoryBarrier barrier{VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER};
+  barrier.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT;
+  barrier.dstAccessMask = VK_ACCESS_HOST_READ_BIT; barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+  barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED; barrier.buffer = readback; barrier.size = VK_WHOLE_SIZE;
+  f.vkCmdPipelineBarrier(command,VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_PIPELINE_STAGE_HOST_BIT,0,0,nullptr,1,&barrier,0,nullptr);
+  submit(VK_NULL_HANDLE,VK_NULL_HANDLE);
+  Check(f.vkInvalidateMappedMemoryRanges(vkdevice,1,&range), "Invalidate staging");
+  uint32_t magic; std::memcpy(&magic,mapped,sizeof(magic));
+  record_test("firstSubmissionComputeReadback", magic == 0x4d4b5655);
+  if (magic != 0x4d4b5655) throw std::runtime_error("Primeiro submit compute perdeu dados (readback divergente)");
+  // Exercise a GPU dependency across submissions without a CPU fence between
+  // them. Never copy the Winlator wrapper's wait-skipping workarounds.
+  std::memset(mapped, 0, 256);
+  Check(f.vkFlushMappedMemoryRanges(vkdevice,1,&range), "Flush semaphore sentinels");
+  VkCommandBuffer chain[2]; ca.commandBufferCount = 2;
+  Check(f.vkAllocateCommandBuffers(vkdevice,&ca,chain), "Semaphore commands");
+  VkCommandBufferBeginInfo chain_begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+  chain_begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+  Check(f.vkBeginCommandBuffer(chain[0],&chain_begin), "Begin producer");
+  f.vkCmdBindPipeline(chain[0],VK_PIPELINE_BIND_POINT_COMPUTE,compute_pipeline);
+  f.vkCmdBindDescriptorSets(chain[0],VK_PIPELINE_BIND_POINT_COMPUTE,compute_layout,0,1,&descriptor_set,0,nullptr);
+  f.vkCmdDispatch(chain[0],1,1,1);
+  Check(f.vkEndCommandBuffer(chain[0]), "End producer");
+  Check(f.vkBeginCommandBuffer(chain[1],&chain_begin), "Begin consumer");
+  auto chain_barrier = barrier;
+  chain_barrier.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT; chain_barrier.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+  f.vkCmdPipelineBarrier(chain[1],VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,VK_PIPELINE_STAGE_TRANSFER_BIT,
+      0,0,nullptr,1,&chain_barrier,0,nullptr);
+  VkBufferCopy chain_copy{0,128,4};
+  f.vkCmdCopyBuffer(chain[1],readback,readback,1,&chain_copy);
+  chain_barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT; chain_barrier.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+  f.vkCmdPipelineBarrier(chain[1],VK_PIPELINE_STAGE_TRANSFER_BIT,VK_PIPELINE_STAGE_HOST_BIT,
+      0,0,nullptr,1,&chain_barrier,0,nullptr);
+  Check(f.vkEndCommandBuffer(chain[1]), "End consumer");
+  VkSemaphoreCreateInfo chain_semaphore_info{VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO};
+  VkSemaphore chain_semaphore;
+  Check(f.vkCreateSemaphore(vkdevice,&chain_semaphore_info,nullptr,&chain_semaphore), "Semaphore producer/consumer");
+  resources.cleanup.emplace_back([=, &f] { f.vkDestroySemaphore(vkdevice,chain_semaphore,nullptr); });
+  VkSubmitInfo producer{VK_STRUCTURE_TYPE_SUBMIT_INFO}, consumer{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+  producer.commandBufferCount = 1; producer.pCommandBuffers = &chain[0];
+  producer.signalSemaphoreCount = 1; producer.pSignalSemaphores = &chain_semaphore;
+  VkPipelineStageFlags chain_wait_stage = VK_PIPELINE_STAGE_TRANSFER_BIT;
+  consumer.commandBufferCount = 1; consumer.pCommandBuffers = &chain[1];
+  consumer.waitSemaphoreCount = 1; consumer.pWaitSemaphores = &chain_semaphore;
+  consumer.pWaitDstStageMask = &chain_wait_stage;
+  Check(f.vkResetFences(vkdevice,1,&fence), "Reset chain fence");
+  { auto queue = device->AcquireQueue(family,0);
+    REXLOG_INFO("[DRIVERPROBE] BEGIN producer/consumer submit");
+    progress("Executando vkQueueSubmit producer");
+    Check(f.vkQueueSubmit(queue.queue(),1,&producer,VK_NULL_HANDLE), "Submit producer");
+    progress("Executando vkQueueSubmit consumer");
+    Check(f.vkQueueSubmit(queue.queue(),1,&consumer,fence), "Submit consumer"); }
+  Check(f.vkWaitForFences(vkdevice,1,&fence,VK_TRUE,5000000000ULL), "Semaphore chain fence (5s)");
+  Check(f.vkInvalidateMappedMemoryRanges(vkdevice,1,&range), "Invalidate chain staging");
+  std::memcpy(&magic,static_cast<const uint8_t*>(mapped)+128,sizeof(magic));
+  record_test("semaphoreComputeTransferReadback", magic == 0x4d4b5655);
+  if (magic != 0x4d4b5655) throw std::runtime_error("Dependência compute/semaphore/transfer perdeu dados");
+  auto draw_readback = [&](VkPipeline pipeline, bool blend_test, const int* expected, const char* test) {
+    REXLOG_INFO("[DRIVERPROBE] BEGIN {}", test);
+    begin();
+    // The previous readback is now completed; discard only the diagnostic
+    // attachment (render pass initialLayout=UNDEFINED) for the next test.
+    clear_pass(offscreen_pass,offscreen_fb,{16,16},pipeline,blend_test);
+    VkBufferImageCopy copy{}; copy.bufferOffset = 256;
+    copy.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT,0,0,1}; copy.imageExtent = {16,16,1};
+    f.vkCmdCopyImageToBuffer(command,image,VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,readback,1,&copy);
+    auto transfer_barrier = barrier;
+    transfer_barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    f.vkCmdPipelineBarrier(command,VK_PIPELINE_STAGE_TRANSFER_BIT,VK_PIPELINE_STAGE_HOST_BIT,
+        0,0,nullptr,1,&transfer_barrier,0,nullptr);
+    submit(VK_NULL_HANDLE,VK_NULL_HANDLE);
+    Check(f.vkInvalidateMappedMemoryRanges(vkdevice,1,&range), "Invalidate draw staging");
+    const auto* pixels = static_cast<const uint8_t*>(mapped) + 256;
+    bool passed = true;
+    for (int i = 0; i < 16*16*4; ++i)
+      if (std::abs(int(pixels[i])-expected[i%4]) > 1) { passed = false; break; }
+    record_test(test, passed);
+    if (!passed) throw std::runtime_error(std::string(test) + ": pixels RGBA8 divergentes");
+  };
+  const int expected[] = {64,128,191,255};
+  draw_readback(graphics_pipeline, false, expected, "triangleReadback");
+  draw_readback(tess_pipeline, false, expected, "tessellationTriangleReadback");
+  // Two draws in one pass: check that blended fragments retain destination
+  // color, a failure fixed in the referenced PanVK v9 forward-pixel-kill path.
+  const int blended_expected[] = {128,96,159,128};
+  draw_readback(graphics_pipeline, true, blended_expected, "blendDestinationReadback");
+
+  VkSurfaceCapabilitiesKHR capabilities;
+  Check(ifn.vkGetPhysicalDeviceSurfaceCapabilitiesKHR(physical,surface,&capabilities), "Surface capabilities");
+  if (!(capabilities.supportedUsageFlags & VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT))
+    throw std::runtime_error("Swapchain sem color attachment");
+  uint32_t format_count = 0;
+  Check(ifn.vkGetPhysicalDeviceSurfaceFormatsKHR(physical,surface,&format_count,nullptr), "Surface formats");
+  std::vector<VkSurfaceFormatKHR> formats(format_count);
+  Check(ifn.vkGetPhysicalDeviceSurfaceFormatsKHR(physical,surface,&format_count,formats.data()), "Surface formats");
+  if (formats.empty()) throw std::runtime_error("Surface sem formatos");
+  auto surface_format = formats.front();
+  if (surface_format.format == VK_FORMAT_UNDEFINED) surface_format.format = VK_FORMAT_R8G8B8A8_UNORM;
+  VkExtent2D extent = capabilities.currentExtent;
+  if (extent.width == UINT32_MAX) extent = {
+      std::clamp(uint32_t(std::max(1,ANativeWindow_getWidth(window))),capabilities.minImageExtent.width,capabilities.maxImageExtent.width),
+      std::clamp(uint32_t(std::max(1,ANativeWindow_getHeight(window))),capabilities.minImageExtent.height,capabilities.maxImageExtent.height)};
+  VkSwapchainCreateInfoKHR sw{VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR};
+  sw.surface = surface; sw.minImageCount = capabilities.minImageCount;
+  sw.imageFormat = surface_format.format; sw.imageColorSpace = surface_format.colorSpace;
+  sw.imageExtent = extent; sw.imageArrayLayers = 1; sw.imageUsage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+  sw.preTransform = capabilities.currentTransform; sw.presentMode = VK_PRESENT_MODE_FIFO_KHR; sw.clipped = VK_TRUE;
+  sw.compositeAlpha = VkCompositeAlphaFlagBitsKHR(capabilities.supportedCompositeAlpha &
+      (~capabilities.supportedCompositeAlpha + 1));
+  VkSwapchainKHR swapchain;
+  Check(f.vkCreateSwapchainKHR(vkdevice,&sw,nullptr,&swapchain), "Swapchain");
+  resources.cleanup.emplace_back([=, &f] { f.vkDestroySwapchainKHR(vkdevice,swapchain,nullptr); });
+  auto semaphore = [&] {
+    VkSemaphoreCreateInfo info{VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO}; VkSemaphore sem;
+    Check(f.vkCreateSemaphore(vkdevice,&info,nullptr,&sem), "Semaphore");
+    resources.cleanup.emplace_back([=, &f] { f.vkDestroySemaphore(vkdevice,sem,nullptr); });
+    return sem;
+  };
+  const auto acquired = semaphore(), rendered = semaphore();
+  uint32_t index;
+  auto acquire_result = f.vkAcquireNextImageKHR(vkdevice,swapchain,5000000000ULL,acquired,VK_NULL_HANDLE,&index);
+  if (acquire_result != VK_SUBOPTIMAL_KHR) Check(acquire_result,"Acquire");
+  uint32_t image_count = 0;
+  Check(f.vkGetSwapchainImagesKHR(vkdevice,swapchain,&image_count,nullptr), "Swapchain images");
+  std::vector<VkImage> swap_images(image_count);
+  Check(f.vkGetSwapchainImagesKHR(vkdevice,swapchain,&image_count,swap_images.data()), "Swapchain images");
+  const auto present_pass = render_pass(surface_format.format,VK_IMAGE_LAYOUT_PRESENT_SRC_KHR);
+  const auto present_fb = framebuffer(present_pass,image_view(swap_images.at(index),surface_format.format),extent);
+  begin(); clear_pass(present_pass,present_fb,extent,VK_NULL_HANDLE); submit(acquired,rendered);
+  VkPresentInfoKHR present{VK_STRUCTURE_TYPE_PRESENT_INFO_KHR};
+  present.waitSemaphoreCount = 1; present.pWaitSemaphores = &rendered;
+  present.swapchainCount = 1; present.pSwapchains = &swapchain; present.pImageIndices = &index;
+  // Exercise the optional same-family present queue as part of compatibility
+  // verification. The composition semaphore carries the dependency from queue 0.
+  const uint32_t present_queue = AndroidPresentationQueueIndex(*device, family);
+  record_uint("graphicsQueuesCreated", uint32_t(device->queue_families()[family].queues.size()));
+  record_uint("presentationQueueIndex", present_queue);
+  { auto result = PanvkNativeSyncQueuePresent(*device,family,present_queue,present);
+    if (result != VK_SUBOPTIMAL_KHR) Check(result,"Present");
+    auto queue = device->AcquireQueue(family,present_queue);
+    Check(f.vkQueueWaitIdle(queue.queue()),"Conclusão da apresentação"); }
+  record_test("androidSurfacePresentation", true);
+  return "Primeiro submit compute, draw, tessellation, blend, readbacks e Surface Android: OK. " + AndroidDriverIdentity();
+}
