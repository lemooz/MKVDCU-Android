+extern "C" JNIEXPORT jstring JNICALL
+Java_org_mkvdcu_android_DriverNative_probe(JNIEnv* env, jclass cls, jobject surface) {
+  ANativeWindow* window = ANativeWindow_fromSurface(env, surface);
+  bool ok = false;
+  std::string message, capabilities = "{}";
+  const auto progress_method = env->GetStaticMethodID(cls, "onProbeProgress", "(Ljava/lang/String;)V");
+  auto progress = [&](const char* phase) {
+    if (!progress_method || env->ExceptionCheck()) return;
+    auto text = env->NewStringUTF(phase);
+    env->CallStaticVoidMethod(cls, progress_method, text);
+    env->DeleteLocalRef(text);
+  };
+  try { message = ProbeAndroidDriver(window, capabilities, progress); ok = true; }
+  catch (const std::exception& exception) { message = exception.what(); }
+  if (window) ANativeWindow_release(window);
+  std::string escaped;
+  for (unsigned char c : message) {
+    if (c == '"' || c == '\\') { escaped += '\\'; escaped += char(c); }
+    else if (c < 32) escaped += ' ';
+    else escaped += char(c);
+  }
+  std::string json = std::string("{\"ok\":") + (ok ? "true" : "false") +
+      ",\"message\":\"" + escaped + "\",\"capabilities\":" + capabilities + "}";
+  return env->NewStringUTF(json.c_str());
+}
