+  const VkImageSubresourceRange subresource_range =
+      ui::vulkan::util::InitializeSubresourceRange();
+  command_processor_.PushImageMemoryBarrier(
+      texture->image(), subresource_range, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+      VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_SHADER_READ_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+      VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  command_processor_.SubmitBarriers(true);
+
+  VkBufferImageCopy copy = {};
+  copy.imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+  copy.imageSubresource.mipLevel = 0;
+  copy.imageSubresource.baseArrayLayer = 0;
+  copy.imageSubresource.layerCount = 1;
+  copy.imageExtent = {width, height, 1};
+  command_processor_.deferred_command_buffer().CmdVkCopyImageToBuffer(
+      texture->image(), VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, readback_buffer, 1, &copy);
+  command_processor_.PushBufferMemoryBarrier(
+      readback_buffer, 0, readback_size, VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_HOST_READ_BIT);
+  command_processor_.PushImageMemoryBarrier(
+      texture->image(), subresource_range, VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_ACCESS_TRANSFER_READ_BIT, VK_ACCESS_SHADER_READ_BIT,
+      VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  command_processor_.SubmitBarriers(true);
+
+  if (command_processor_.AwaitAllQueueOperationsCompletion()) {
+    VkMappedMemoryRange mapped_range = {};
+    mapped_range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+    mapped_range.memory = readback_memory;
+    mapped_range.offset = 0;
+    mapped_range.size = VK_WHOLE_SIZE;
+    const VkResult invalidate = dfn.vkInvalidateMappedMemoryRanges(device, 1, &mapped_range);
+    if (invalidate == VK_SUCCESS) {
+      const auto* bytes = static_cast<const uint8_t*>(mapped);
+      uint64_t non_zero = 0;
+      uint64_t checksum = 1469598103934665603ull;
+      uint32_t minimum = UINT32_MAX, maximum = 0;
+      uint32_t channel_min[4] = {255, 255, 255, 255};
+      uint32_t channel_max[4] = {};
+      uint64_t channel_nonzero[4] = {};
+      std::string sample;
+      uint64_t varying_pixels = 0;
+      const uint8_t* first_pixel = bytes;
+      for (uint32_t i = 0; i < readback_size; ++i) {
+        non_zero += bytes[i] != 0;
+        minimum = std::min(minimum, uint32_t(bytes[i]));
+        maximum = std::max(maximum, uint32_t(bytes[i]));
+        checksum = (checksum ^ bytes[i]) * 1099511628211ull;
+        if (i < 16) {
+          if (i) sample += ' ';
+          sample += fmt::format("{:02X}", bytes[i]);
+        }
+      }
+      if (bytes_per_block == 4) {
+        for (uint32_t i = 0; i + 3 < readback_size; i += 4) {
+          for (uint32_t channel = 0; channel < 4; ++channel) {
+            channel_min[channel] = std::min(channel_min[channel], uint32_t(bytes[i + channel]));
+            channel_max[channel] = std::max(channel_max[channel], uint32_t(bytes[i + channel]));
+            channel_nonzero[channel] += bytes[i + channel] != 0;
+          }
+        }
+        for (uint32_t i = 4; i + 3 < readback_size; i += 4) {
+          varying_pixels += std::memcmp(first_pixel, bytes + i, 4) != 0;
+        }
+      }
+      const bool rgba8 = host_format.format == VK_FORMAT_R8G8B8A8_UNORM ||
+                         host_format.format == VK_FORMAT_R8G8B8A8_SRGB;
+      REXLOG_INFO("[FRAMEPROBE][GAME_TEXTURE_IMAGE] fetch={} address=0x{:08X} size={} "
+                  "nonZero={} min={} max={} varying_pixels={} checksum=0x{:016X} sample={} "
+                  "byte0={}-{}:{} byte1={}-{}:{} byte2={}-{}:{} byte3={}-{}:{} rgba8={}",
+                  fetch_constant_index, address, readback_size, non_zero, minimum, maximum,
+                  varying_pixels, checksum, sample, channel_min[0], channel_max[0], channel_nonzero[0],
+                  channel_min[1], channel_max[1], channel_nonzero[1], channel_min[2], channel_max[2],
+                  channel_nonzero[2], channel_min[3], channel_max[3], channel_nonzero[3], rgba8);
+      if (bytes_per_block == 4) {
+        const std::string kTextureProbePath = fmt::format(
+            "/data/user/0/org.mkvdcu.android/files/frameprobe_texture_{:08X}.{}", address,
+            rgba8 ? "rgba" : "bin");
