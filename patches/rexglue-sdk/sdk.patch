diff --git a/src/ui/android_driver/panvk_loader_hook.cpp b/src/ui/android_driver/panvk_loader_hook.cpp
new file mode 100644
index 0000000..48cb1f1
--- /dev/null
+++ b/src/ui/android_driver/panvk_loader_hook.cpp
@@ -0,0 +1,91 @@
+// Dedicated Android Vulkan HAL selection bridge. No Qualcomm/KGSL behavior.
+#include "panvk_loader_hook.h"
+#include <cstring>
+#include <cerrno>
+#ifndef PANVK_MAPPER_ONLY
+extern "C" {
+// hw_module_t LP64 ABI, copied from the runtime's checked HAL proxy.
+alignas(8) __attribute__((visibility("default"))) unsigned char HMI[248] = {};
+__attribute__((visibility("default")))
+void mkvdcu_panvk_set_hal_module(const void* module) { std::memcpy(HMI, module, sizeof(HMI)); }
+}
+#endif
+
+namespace {
+void* selected_hal = nullptr;
+PanvkDlopenExt original_dlopen_ext = nullptr;
+PanvkLoadSphal original_load_sphal = nullptr;
+PanvkAccess original_access = nullptr;
+void* mapper_hook = nullptr;
+
+// Mesa Android 014 enumerates mapper@4.0-impl-<instance>.so. Some stock
+// vendors ship the default instance without that suffix. Alias only the
+// missing default filename to the real HIDL library, preserving its ABI and
+// metadata implementation. Never fabricate an AHardwareBuffer layout.
+const char* DefaultMapper(const char* path) {
+  if (!mapper_hook || !original_access || !path) return path;
+  constexpr const char* aliases[] = {
+      "/vendor/lib64/hw/android.hardware.graphics.mapper@4.0-impl-default.so",
+      "/odm/lib64/hw/android.hardware.graphics.mapper@4.0-impl-default.so"};
+  constexpr const char* originals[] = {
+      "/vendor/lib64/hw/android.hardware.graphics.mapper@4.0-impl.so",
+      "/odm/lib64/hw/android.hardware.graphics.mapper@4.0-impl.so"};
+  for (unsigned i = 0; i < 2; ++i) {
+    if (std::strcmp(path, aliases[i])) continue;
+    if (original_access(path, 0) == 0 || errno != ENOENT) return path;
+    if (original_access(originals[i], 0) == 0) return originals[i];
+    return path;
+  }
+  return path;
+}
+bool VulkanHal(const char* path) {
+  if (!path) return false;
+  const char* slash = std::strrchr(path, '/');
+  const char* name = slash ? slash + 1 : path;
+  const size_t length = std::strlen(name);
+  return length >= 9 && !std::strncmp(name, "vulkan.", 7) &&
+      !std::strcmp(name + length - 3, ".so");
+}
+}
+extern "C" __attribute__((visibility("default")))
+void mkvdcu_panvk_initialize_loader_hook(void* hal, PanvkDlopenExt dlopen_ext, PanvkLoadSphal sphal) {
+  selected_hal = hal;
+  original_dlopen_ext = dlopen_ext;
+  original_load_sphal = sphal;
+}
+extern "C" __attribute__((visibility("default")))
+void mkvdcu_panvk_initialize_mapper_hook(void* self, PanvkDlopenExt dlopen_ext,
+                                       PanvkLoadSphal sphal, PanvkAccess access_fn) {
+  mapper_hook = self;
+  original_dlopen_ext = dlopen_ext;
+  original_load_sphal = sphal;
+  original_access = access_fn;
+}
+extern "C" __attribute__((visibility("default")))
+int access(const char* path, int mode) {
+  if (!original_access) { errno = ENOSYS; return -1; }
+  return original_access(DefaultMapper(path), mode);
+}
+extern "C" __attribute__((visibility("default")))
+void* dlopen(const char* filename, int flags) {
+  // Mesa obtains android_load_sphal_library using dlsym of this handle. Keep
+  // that call in this private bridge so the default HIDL alias reaches SPHAL.
+  if (mapper_hook && filename && (!std::strcmp(filename, "libvndksupport.so") ||
+      !std::strcmp(filename, "/system/lib64/libvndksupport.so"))) return mapper_hook;
+  const char* path = DefaultMapper(filename);
+  if (path != filename && original_load_sphal)
+    return original_load_sphal(path, flags);
+  return original_dlopen_ext ? original_dlopen_ext(path, flags, nullptr) : nullptr;
+}
+extern "C" __attribute__((visibility("default")))
+void* android_dlopen_ext(const char* filename, int flags, const android_dlextinfo* info) {
+  if (VulkanHal(filename)) return selected_hal;
+  return original_dlopen_ext ? original_dlopen_ext(filename, flags, info) : nullptr;
+}
+extern "C" __attribute__((visibility("default")))
+void* android_load_sphal_library(const char* filename, int flags) {
+  if (VulkanHal(filename)) return selected_hal;
+  const char* path = DefaultMapper(filename);
+  if (original_load_sphal) return original_load_sphal(path, flags);
+  return original_dlopen_ext ? original_dlopen_ext(path, flags, nullptr) : nullptr;
+}
