+/**
+ * @file        frame_generation.h
+ * @brief       Motion-compensated frame interpolation of the guest output (frame generation).
+ *
+ * Between two guest frames the generator estimates block motion on quarter-resolution luma
+ * (full search, 3x3 vector median) and renders the frame at time t by sampling the previous frame
+ * backward and the current one forward along the motion, falling back to a cross-fade where the two
+ * disagree (occlusions, bad vectors). All passes are compute work recorded into the command
+ * processor's command buffer ahead of the swap, at guest-output resolution.
+ */
+
+#pragma once
+
+#include <array>
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <mutex>
+#include <thread>
+
+#include <rex/ui/vulkan/api.h>
+
+namespace rex::ui {
+class Presenter;
+}
+namespace rex::ui::vulkan {
+class VulkanDevice;
+}
+
+namespace rex::graphics::vulkan {
+
+class VulkanCommandProcessor;
+
+class FrameGenerator {
+ public:
+  explicit FrameGenerator(VulkanCommandProcessor& command_processor);
+  ~FrameGenerator();
+
+  bool Initialize();
+  void Shutdown();
+
+  // Records the passes producing the frame at time t (0..1) between the frame given to the
+  // previous call and `current` (a view in SHADER_READ_ONLY_OPTIMAL, sampled with the RGB order the
+  // swap expects), then keeps `current` as the next call's previous frame. Must be called outside a
+  // render pass. Returns whether an interpolated frame was produced (false on the first frame or
+  // after a size change); interpolated_view() is then in SHADER_READ_ONLY_OPTIMAL.
+  static constexpr int kMaxGenerated = 3;
+  // Produces `count` (<= kMaxGenerated) frames at the times `t` (ascending, in (0, 1)).
+  int Record(VkImageView current, uint32_t width, uint32_t height, const float* t, int count);
+  VkImageView interpolated_view(int k) const { return interp_[k].view; }
+
+  // Presentation. The swap renders the interpolated and the real frame (through the usual swap
+  // refresher) into one of two slots of guest-output-format images; a pacer thread then hands them
+  // to the presenter one after the other, so FIFO presentation shows them on consecutive vblanks
+  // and only the pacer ever waits for the display.
+  struct OutputImage {
+    VkImage image = VK_NULL_HANDLE;
+    VkDeviceMemory memory = VK_NULL_HANDLE;
+    VkImageView view = VK_NULL_HANDLE;
+    uint64_t version = 0;
+    bool written = false;
+  };
+  struct Entry {
+    int slot = -1;
+    int interp_count = 0;
+    bool interp_8bpc[kMaxGenerated] = {true, true, true};
+    bool real_8bpc = true;
+    uint32_t width = 0, height = 0, display_width = 0, display_height = 0;
+  };
+  // Waits (bounded) until the pacer no longer uses the next slot; returns it, or -1.
+  int AcquireSlot();
+  void ReleaseSlot(int slot);
+  bool EnsureOutputs(uint32_t width, uint32_t height);
+  // Index 0..kMaxGenerated-1: generated frames; kMaxGenerated: the real frame.
+  OutputImage& output(int slot, int index) { return outputs_[slot * (kMaxGenerated + 1) + index]; }
+  void Submit(const Entry& entry, ui::Presenter* presenter);
+
+ private:
+  struct Image {
+    VkImage image = VK_NULL_HANDLE;
+    VkDeviceMemory memory = VK_NULL_HANDLE;
+    VkImageView view = VK_NULL_HANDLE;
+    VkImageLayout layout = VK_IMAGE_LAYOUT_UNDEFINED;
+  };
+  enum Pass { kLuma, kMatch, kMedian, kInterp, kCopy, kPassCount };
+  static constexpr uint32_t kSlots = 8;
+
+  bool EnsureImages(uint32_t width, uint32_t height);
+  void PacerMain();
+  bool CopyToPresenter(const OutputImage& source, VkImage destination, uint32_t width,
+                       uint32_t height);
+  void DestroyOutputs();
+  bool CreateImage(Image& image, uint32_t width, uint32_t height);
+  void DestroyImage(Image& image);
+  void DestroyImages();
+  void Transition(Image& image, VkImageLayout new_layout, VkPipelineStageFlags src_stage,
+                  VkAccessFlags src_access);
+  void Dispatch(Pass pass, VkDescriptorSet set, const int32_t a[4], const float b[4],
+                uint32_t groups_x, uint32_t groups_y);
+
+  VulkanCommandProcessor& command_processor_;
+  VkDescriptorSetLayout set_layout_ = VK_NULL_HANDLE;
+  VkPipelineLayout pipeline_layout_ = VK_NULL_HANDLE;
+  VkDescriptorPool pool_ = VK_NULL_HANDLE;
+  VkSampler sampler_ = VK_NULL_HANDLE;
+  std::array<VkPipeline, kPassCount> pipelines_{};
+  // Per slot: one set per pass, plus sets for the 2nd and 3rd generated frame.
+  static constexpr uint32_t kSetsPerSlot = kPassCount + kMaxGenerated - 1;
+  std::array<std::array<VkDescriptorSet, kSetsPerSlot>, kSlots> sets_{};
+  uint32_t slot_ = 0;
+
+  uint32_t width_ = 0, height_ = 0;
